Cell[BoxData[{
 RowBox[{
  RowBox[{"validRegion", "[", 
   RowBox[{
    RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Beta]_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"RstarNum", "[", 
      RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], ">", "0"}], "&&", 
    RowBox[{
     RowBox[{"cstarNum", "[", 
      RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], ">", "0"}]}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{"stable", "[", 
   RowBox[{
    RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Beta]_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"validRegion", "[", 
    RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], "&&", 
   RowBox[{
    RowBox[{"trNum", "[", 
     RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], "<", "0"}], "&&", 
   RowBox[{
    RowBox[{"detNum", "[", 
     RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], ">", "0"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dampedOsc", "[", 
   RowBox[{
    RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
    RowBox[{"\[Beta]_", "?", "NumericQ"}]}], "]"}], ":=", 
  RowBox[{
   RowBox[{"stable", "[", 
    RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], "&&", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"trNum", "[", 
        RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], "^", "2"}], "-", 
      RowBox[{"4", " ", 
       RowBox[{"detNum", "[", 
        RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}]}]}], "<", "0"}], 
    ")"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nonOsc", "[", 
    RowBox[{
     RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Beta]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"stable", "[", 
     RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], "&&", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"trNum", "[", 
         RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], "^", "2"}], "-", 
       RowBox[{"4", " ", 
        RowBox[{"detNum", "[", 
         RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}]}]}], ">=", "0"}], 
     ")"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hopf", "[", 
    RowBox[{
     RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Beta]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{
    RowBox[{"validRegion", "[", 
     RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], "&&", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"trNum", "[", 
       RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], "]"}], "<", 
     RowBox[{"10", "^", 
      RowBox[{"-", "4"}]}]}], "&&", 
    RowBox[{
     RowBox[{"detNum", "[", 
      RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}], ">", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"nonCoexist", "[", 
    RowBox[{
     RowBox[{"\[Eta]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Beta]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"!", 
    RowBox[{"validRegion", "[", 
     RowBox[{"\[Eta]", ",", "\[Beta]"}], "]"}]}]}], ";"}]}], "Input",
