   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Check", " ", "the", " ", "baseline", " ", "deterministic", " ", "dose"}],
     "\[Dash]", 
    RowBox[{"response", " ", "function"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baseline", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", 
       RowBox[{"DRFunLogExp", "[", 
        RowBox[{"d", ",", "x0", ",", "beta", ",", "NEC"}], "]"}]}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"d", ",", "Dose"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotBaseline", "[", "baseline_", "]"}], ":=", 
  RowBox[{"ListLinePlot", "[", "\[IndentingNewLine]", 
   RowBox[{"baseline", ",", "\[IndentingNewLine]", 
    RowBox[{"PlotLabel", "->", 
     RowBox[{"StringForm", "[", 
      RowBox[{"\"\<Baseline: \!\(\*Cell[TextData[Cell[BoxData[FormBox[
SubscriptBox[\"x\", \"0\"], \
TraditionalForm]],ExpressionUUID->\"0f1db81a-4ecc-d248-a83b-4deab53abf70\"]],\
ExpressionUUID->\"e4cc10d2-dc44-7d4d-b168-93bfebf3891f\"]\)=``, NEC=``, \
\[Beta]=``\>\"", ",", "x0", ",", "NEC", ",", "beta"}], "]"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"Frame", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"True", ",", "False"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"True", ",", "False"}], "}"}]}], "}"}]}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
      RowBox[{"\"\<Concentration\>\"", ",", "\"\<x\>\""}], "}"}]}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baselinePlot", "=", 
   RowBox[{"plotBaseline", "[", "baseline", "]"}]}], 
  ";"}], "\[IndentingNewLine]", "baselinePlot"}], "Input",
 CellChangeTimes->{{3.9724602798514996`*^9, 3.972460323517002*^9}, {
