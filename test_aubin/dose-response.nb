            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"stdNull", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"meanMax", "-", "meanMin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"stdMax", "-", "stdMin"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"meanMin", "-", 
        RowBox[{"a", "*", "stdMin"}]}]}], ";", "\[IndentingNewLine]", 
