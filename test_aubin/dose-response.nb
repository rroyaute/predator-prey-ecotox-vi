 RowBox[{
  RowBox[{"idMaxNeg", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"dvalsNeg", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", ">", "2.5"}], "&"}], "->", "\"\<Index\>\""}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
