Cell[TextData[{
 "We can now compute the population distribution for each dose, and plot mean \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5604ee3c-7093-2a4f-9240-aec8d2dfd622"],
 " and standard deviation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],ExpressionUUID->
  "14d3f18a-4e7e-6147-9834-ff9c36af6fd7"],
 " for varying concentrations (this takes a few moments):"
}], "Text",
 CellChangeTimes->{
  3.9724557277083206`*^9, {3.9724608178733425`*^9, 3.9724608294248543`*^9}, {
   3.97246461174543*^9, 
   3.972464613499029*^9}},ExpressionUUID->"ef83f9af-9028-4843-b5cc-\
1e5d1f8c7ed2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SimulateDoseResponse", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"SimulateDoseResponse", "[", "individuals_List", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"records", ",", "data"}], "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"records", "=", 
        RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"Table", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"With", "[", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{
                RowBox[{"x0", "=", 
                 RowBox[{"ind", "[", "\"\<x0\>\"", "]"}]}], ",", 
                RowBox[{"b", "=", "beta"}], ",", 
                RowBox[{"n", "=", 
                 RowBox[{"ind", "[", "\"\<NEC\>\"", "]"}]}]}], "}"}], ",", 
              "\[IndentingNewLine]", 
              RowBox[{"Table", "[", "\[IndentingNewLine]", 
               RowBox[{
                RowBox[{"Module", "[", 
                 RowBox[{
                  RowBox[{"{", 
                   RowBox[{"logyhat", ",", "yhat", ",", "y"}], "}"}], ",", 
                  "\[IndentingNewLine]", 
                  RowBox[{
                   RowBox[{"logyhat", "=", 
                    RowBox[{"DRFunLog", "[", 
                    RowBox[{"d", ",", "x0", ",", "b", ",", "n"}], "]"}]}], ";",
                    "\[IndentingNewLine]", 
                   RowBox[{"yhat", "=", 
                    RowBox[{"Exp", "[", "logyhat", "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"y", "=", 
                    RowBox[{"RandomVariate", "[", 
                    RowBox[{"LogNormalDistribution", "[", 
                    RowBox[{"logyhat", ",", "sigma"}], "]"}], "]"}]}], ";", 
                   "\[IndentingNewLine]", 
                   RowBox[{"<|", 
                    RowBox[{
                    RowBox[{"\"\<ID\>\"", "->", 
                    RowBox[{"ind", "[", "\"\<ID\>\"", "]"}]}], ",", 
                    RowBox[{"\"\<Dose\>\"", "->", "d"}], ",", 
                    RowBox[{"\"\<logyhat\>\"", "->", "logyhat"}], ",", 
                    RowBox[{"\"\<yhat\>\"", "->", "yhat"}], ",", 
                    RowBox[{"\"\<y\>\"", "->", "y"}]}], "|>"}]}]}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"d", ",", "Dose"}], "}"}]}], "\[IndentingNewLine]", 
               "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"ind", ",", "individuals"}], "}"}]}], "]"}], 
          "\[IndentingNewLine]", ",", "1"}], "\[IndentingNewLine]", "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"data", "=", 
        RowBox[{"GroupBy", "[", 
         RowBox[{"records", ",", 
          RowBox[{"#Dose", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Compute", " ", "mean", " ", "and", " ", "sd", " ", "per", " ", 
         "Dose"}], "*)"}], "\[IndentingNewLine]", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"vals", "=", 
             RowBox[{"data", "[", "d", "]"}]}], "}"}], ",", 
           "\[IndentingNewLine]", 
           RowBox[{"<|", 
            RowBox[{
             RowBox[{"\"\<Dose\>\"", "->", "d"}], ",", 
             RowBox[{"\"\<yhatMean\>\"", "->", 
              RowBox[{"Mean", "[", 
               RowBox[{"vals", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "\"\<yhat\>\""}], "]"}], "]"}], "]"}]}], 
             ",", 
             RowBox[{"\"\<yhatSD\>\"", "->", 
              RowBox[{"StandardDeviation", "[", 
               RowBox[{"vals", "[", 
                RowBox[{"[", 
                 RowBox[{"All", ",", "\"\<yhat\>\""}], "]"}], "]"}], 
               "]"}]}]}], "|>"}]}], "\[IndentingNewLine]", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"d", ",", 
           RowBox[{"Keys", "[", "data", "]"}]}], "}"}]}], 
        "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
   ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Positive", " ", "covariance", " ", "between", " ", "alpha", " ", "and", " ",
     "NEC"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"summaryPos", "=", 
    RowBox[{"SimulateDoseResponse", "[", "individualsPos", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Negative", " ", "covariance", " ", "between", " ", "alpha", " ", "and", " ",
     "NEC"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"summaryNeg", "=", 
    RowBox[{"SimulateDoseResponse", "[", "individualsNeg", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "No", " ", "correlation", " ", "between", " ", "alpha", " ", "and", " ", 
    "NEC"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"summaryNull", "=", 
    RowBox[{"SimulateDoseResponse", "[", "individualsNull", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Concentration", ",", " ", 
    RowBox[{
    "mean", " ", "Table", " ", "for", " ", "each", " ", "population"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanPos", "=", 
   RowBox[{
    RowBox[{"summaryPos", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatMean\>\"", "]"}]}], "}"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanNeg", "=", 
   RowBox[{
    RowBox[{"summaryNeg", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatMean\>\"", "]"}]}], "}"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"meanNull", "=", 
    RowBox[{
     RowBox[{"summaryNull", "[", 
      RowBox[{"[", "All", "]"}], "]"}], "/.", 
     RowBox[{"assoc_Association", ":>", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
        RowBox[{"assoc", "[", "\"\<yhatMean\>\"", "]"}]}], "}"}]}]}]}], ";"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Concentration", ",", " ", 
    RowBox[{
    "standard", " ", "deviation", " ", "for", " ", "each", " ", 
     "population"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stdPos", "=", 
   RowBox[{
    RowBox[{"summaryPos", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatSD\>\"", "]"}]}], "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stdNeg", "=", 
   RowBox[{
    RowBox[{"summaryNeg", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatSD\>\"", "]"}]}], "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stdNull", "=", 
   RowBox[{
    RowBox[{"summaryNull", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatSD\>\"", "]"}]}], "}"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9724557731487885`*^9, 3.972455773266407*^9}, {
  3.972455822982334*^9, 3.9724559592781487`*^9}, {3.972458622973692*^9, 
  3.9724586239035664`*^9}, {3.972460202741682*^9, 3.9724602096277905`*^9}, {
  3.9724607232493763`*^9, 3.97246072805455*^9}, {3.9724608529023895`*^9, 
  3.9724608618706436`*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"e4904e9b-14f6-f348-9aff-688349ae9715"],

Cell["\<\
Let\[CloseCurlyQuote]s plot the resulting population response to different \
concentrations:\
\>", "Text",
 CellChangeTimes->{{3.972455984900776*^9, 
  3.9724560008946877`*^9}},ExpressionUUID->"ec04866c-5f99-1342-a91d-\
f4a830184e05"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"plotResponse", "[", 
    RowBox[{
    "meanPos_", ",", "meanNeg_", ",", "meanNull_", ",", "stdPos_", ",", 
     "stdNeg_", ",", "stdNull_", ",", "majorStep_"}], "]"}], ":=", 
   RowBox[{"Module", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "meanMin", ",", "meanMax", ",", "stdMin", ",", "stdMax", ",", "a", ",", 
       "b", ",", "mapStd", ",", "invMap", ",", "majorTicks", ",", 
       "minorTicks", ",", "rightTicks", ",", "frameTicks", ",", "colPos", ",",
        "colNeg", ",", "colNull", ",", "plotMean", ",", "plotStd", ",", 
       "dualPlot", ",", "dualPlotLegend"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Visual", " ", "parameters"}], "*)"}], "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"meanMin", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"meanPos", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"meanNeg", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"meanNull", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"meanMax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"meanPos", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"meanNeg", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"meanNull", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"stdMin", "=", 
       RowBox[{"Min", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"stdPos", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"stdNeg", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"stdNull", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"stdMax", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"Flatten", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"stdPos", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"stdNeg", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}], ",", 
           RowBox[{"stdNull", "[", 
            RowBox[{"[", 
             RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}], "]"}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"a", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"meanMax", "-", "meanMin"}], ")"}], "/", 
        RowBox[{"(", 
         RowBox[{"stdMax", "-", "stdMin"}], ")"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"b", "=", 
       RowBox[{"meanMin", "-", 
        RowBox[{"a", "*", "stdMin"}]}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mapStd", "[", 
        RowBox[{"{", 
         RowBox[{"x_", ",", "y_"}], "}"}], "]"}], ":=", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{
          RowBox[{"a", "*", "y"}], "+", "b"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"invMap", "[", "y_", "]"}], ":=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"y", "-", "b"}], ")"}], "/", "a"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"majorTicks", "=", 
