Cell[TextData[{
 "We can observe that for positive or negative covariance, we have first an \
effect of concentration on \[Sigma] (for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], "<", 
         OverscriptBox[
          StyleBox["NEC", FontSlant -> "Plain"], "_"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "C<\\bar{\\mathrm{NEC}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c973eb25-8851-6041-a1cb-0f9e775d18f4"],
 "), followed by an effect on ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "a7f16b8d-4575-ce48-afce-ea1b3326a8f6"],
 " (for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["C", "TI"], "\[TildeTilde]", 
         OverscriptBox[
          StyleBox["NEC", FontSlant -> "Plain"], "_"]}], TraditionalForm], 
     "errors" -> {}, "input" -> "C\\approx \\bar{\\mathrm{NEC}}", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "3439f0f1-7b00-334f-9f65-b23e53b4b598"],
 ").\nFor the positive covariance case, the effect on \[Sigma] leads to an \
increase of variance among the population as the mean starts to decrease, \
followed by a decrease of variance.\nFor the negative covariance case,  the \
effect on \[Sigma] always leads to a decrease of variance among the \
population.\nThe zero covariance case (independent parameters) also shows a \
slight increase in \[Sigma], but only after ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "978e883d-6e6f-af4b-b0fa-de6cf2352ed1"],
 " starts to decrease, followed by a further decrease of \[Sigma]."
}], "Text",
 CellChangeTimes->{{3.972456182962303*^9, 3.97245641432518*^9}, {
  3.972456482411503*^9, 
  3.9724565089220123`*^9}},ExpressionUUID->"7540acfd-2a3b-b642-81f5-\
5931ae15202c"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Modification of the predator-prey dynamics", "Chapter",
 CellChangeTimes->{{3.9724566121298885`*^9, 
  3.972456621447111*^9}},ExpressionUUID->"c14d79d8-6bf8-0f4b-b877-\
485c65589f85"],

Cell["\<\
We can now include this effect on the predator-prey system, following the \
equilibrium analysis developed in `method_jacob.nb`.\
\>", "Text",
 CellChangeTimes->{{3.9724566266301613`*^9, 
  3.972456668482912*^9}},ExpressionUUID->"a9b06352-5d34-774d-b781-\
38b93371b11e"],

Cell[CellGroupData[{

Cell["Functions definitions", "Section",
 CellChangeTimes->{{3.9724566820944977`*^9, 
  3.9724566887616196`*^9}},ExpressionUUID->"ff8363b6-3aad-004a-8609-\
73d611616a1f"],

Cell["See `method_jacob.nb\.08` for details on this part.", "Text",
 CellChangeTimes->{{3.9724566922842503`*^9, 
  3.972456705535042*^9}},ExpressionUUID->"6e0ecffc-5c3b-4740-bf9b-\
d31072d15666"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "FUNCTIONS"}]}], " ", 
     RowBox[{"DEFINITIONS", " ", "--"}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"pdist", ",", "attack", ",", "handling"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pdist", "[", 
      RowBox[{"x_", ",", "X_", ",", "\[Sigma]_"}], "]"}], ":=", 
     RowBox[{
      FractionBox["1", 
       SqrtBox[
        RowBox[{"2", "\[Pi]", " ", "\[Sigma]"}]]], 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "X"}], ")"}], "2"], 
         RowBox[{"2", "\[Sigma]"}]]}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"attack", "[", 
      RowBox[{"x_", ",", "a_", ",", "\[Alpha]_", ",", "\[Tau]_"}], "]"}], ":=", 
     RowBox[{"\[Alpha]", " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{"-", 
        FractionBox[
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "a"}], ")"}], "2"], 
         RowBox[{"2", 
          SuperscriptBox["\[Tau]", "2"]}]]}]]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"handling", "[", 
      RowBox[{
      "x_", ",", "h_", ",", "\[Eta]min_", ",", "\[Eta]max_", ",", "\[Nu]_"}], 
      "]"}], ":=", 
     RowBox[{"\[Eta]max", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"\[Eta]max", "-", "\[Eta]min"}], ")"}], 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{"-", 
         FractionBox[
          SuperscriptBox[
           RowBox[{"(", 
            RowBox[{"x", "-", "h"}], ")"}], "2"], 
          RowBox[{"2", 
           SuperscriptBox["\[Nu]", "2"]}]]}]]}]}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "MEMOIZED"}]}], " ", 
      RowBox[{"INTEGRALS", " ", "--"}]}], "-"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"Int1", ",", "Int2"}], "]"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Int1", "[", 
      RowBox[{
       RowBox[{"R_", "?", "NumericQ"}], ",", 
       RowBox[{"a_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Tau]_", "?", "NumericQ"}], ",", 
       RowBox[{"h_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]min_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]max_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Nu]_", "?", "NumericQ"}], ",", 
       RowBox[{"X_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]_", "?", "NumericQ"}]}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Int1", "[", 
       RowBox[{
       "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
        "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
        "\[Sigma]"}], "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xmin", "=", 
           RowBox[{"X", "-", 
            RowBox[{"5", "\[Sigma]"}]}]}], ",", 
          RowBox[{"xmax", "=", 
           RowBox[{"X", "+", 
            RowBox[{"5", "\[Sigma]"}]}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"attack", "[", 
             RowBox[{"x", ",", "a", ",", "\[Alpha]", ",", "\[Tau]"}], "]"}], "/", 
            RowBox[{"(", 
             RowBox[{"1", "+", 
              RowBox[{
               RowBox[{"attack", "[", 
                RowBox[{"x", ",", "a", ",", "\[Alpha]", ",", "\[Tau]"}], 
                "]"}], 
               RowBox[{"handling", "[", 
                RowBox[{
                "x", ",", "h", ",", "\[Eta]min", ",", "\[Eta]max", ",", 
                 "\[Nu]"}], "]"}], "R"}]}], ")"}]}], 
           RowBox[{"pdist", "[", 
            RowBox[{"x", ",", "X", ",", "\[Sigma]"}], "]"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[Sigma]", "<", "1"}], ",", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"adaptive", " ", "integration", " ", "limits"}], ",", 
              " ", 
              RowBox[{
              "because", " ", "when", " ", "\[Sigma]", " ", "is", " ", "too", 
               " ", "small"}], ",", " ", 
              RowBox[{
              "numerical", " ", "integration", " ", "is", " ", "wrong"}]}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"X", "-", "5"}], ",", 
              RowBox[{"X", "+", "5"}]}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Int2", "[", 
      RowBox[{
       RowBox[{"R_", "?", "NumericQ"}], ",", 
       RowBox[{"a_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Tau]_", "?", "NumericQ"}], ",", 
       RowBox[{"h_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]min_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]max_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Nu]_", "?", "NumericQ"}], ",", 
       RowBox[{"X_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Int2", "[", 
       RowBox[{
       "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
        "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
        "\[Sigma]"}], "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xmin", "=", 
           RowBox[{"X", "-", 
            RowBox[{"5", "\[Sigma]"}]}]}], ",", 
          RowBox[{"xmax", "=", 
           RowBox[{"X", "+", 
            RowBox[{"5", "\[Sigma]"}]}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"NIntegrate", "[", "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"With", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"A", "=", 
               RowBox[{"attack", "[", 
                RowBox[{"x", ",", "a", ",", "\[Alpha]", ",", "\[Tau]"}], 
                "]"}]}], ",", 
              RowBox[{"H", "=", 
               RowBox[{"handling", "[", 
                RowBox[{
                "x", ",", "h", ",", "\[Eta]min", ",", "\[Eta]max", ",", 
                 "\[Nu]"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"A", "/", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"A", " ", "H", " ", "R"}]}], ")"}]}], 
             RowBox[{"pdist", "[", 
              RowBox[{"x", ",", "X", ",", "\[Sigma]"}], "]"}], 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"A", " ", "H", " ", "R"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"A", " ", "H", " ", "R"}]}], ")"}]}]}], ")"}]}]}], 
           "\[IndentingNewLine]", "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"\[Sigma]", "<", "1"}], ",", 
            RowBox[{"(*", " ", 
             RowBox[{
              RowBox[{"adaptive", " ", "integration", " ", "limits"}], ",", 
              " ", 
              RowBox[{
              "because", " ", "when", " ", "\[Sigma]", " ", "is", " ", "too", 
               " ", "small"}], ",", " ", 
              RowBox[{
              "numerical", " ", "integration", " ", "is", " ", "wrong"}]}], 
             "*)"}], "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"x", ",", 
              RowBox[{"X", "-", "5"}], ",", 
              RowBox[{"X", "+", "5"}]}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], 
           "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "]"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", " ", "MODEL"}]}], " ", 
      RowBox[{"DEFINITION", " ", "--"}]}], "-"}], " ", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"FNum", ",", "EqSol", ",", "DetTr", ",", "Classifying"}], "]"}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"FNum", "[", 
      RowBox[{
       RowBox[{"R_", "?", "NumericQ"}], ",", 
       RowBox[{"a_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Tau]_", "?", "NumericQ"}], ",", 
       RowBox[{"h_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]min_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]max_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Nu]_", "?", "NumericQ"}], ",", 
       RowBox[{"X_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Beta]_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Epsilon]_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"R", " ", 
       RowBox[{"Int1", "[", 
        RowBox[{
        "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
         "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
         "\[Sigma]"}], "]"}]}], "-", 
      FractionBox["\[Beta]", "\[Epsilon]"]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"X", "=", "3"}], ";"}], 
   RowBox[{"(*", 
    RowBox[{"arbitrary", ",", " ", 
     RowBox[{"can", " ", "be", " ", "any", " ", "real", " ", "number"}]}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"paramsGen", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r", "->", "0.3"}], ",", 
       RowBox[{"\[Alpha]", "->", "2"}], ",", 
       RowBox[{"\[Eta]max", "->", "2"}], ",", 
       RowBox[{"\[Eta]min", "->", "1"}], ",", 
       RowBox[{"\[Epsilon]", "->", "0.5"}], ",", 
       RowBox[{"\[Tau]", "->", "1"}], ",", 
       RowBox[{"\[Nu]", "->", "1"}], ",", 
       RowBox[{"k", "->", "1"}], ",", 
       RowBox[{"\[Beta]", "->", "0.1"}], ",", 
       RowBox[{"X", "->", "X"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"EqSol", "[", 
     RowBox[{
      RowBox[{"dval_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Sigma]val_", "?", "NumericQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"paramsSpec", ",", "FNumVal", ",", "Rsol", ",", "csol"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"paramsSpec", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"paramsGen", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "->", 
             RowBox[{"X", "-", "dval"}]}], ",", 
            RowBox[{"h", "->", 
             RowBox[{"X", "-", "dval"}]}], ",", 
            RowBox[{"\[Sigma]", "->", "\[Sigma]val"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"FNumVal", "[", 
         RowBox[{"R_", "?", "NumericQ"}], "]"}], ":=", 
        RowBox[{
         RowBox[{"FNum", "[", 
          RowBox[{
          "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
           "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
           "\[Sigma]", ",", "\[Beta]", ",", "\[Epsilon]"}], "]"}], "/.", 
         "paramsSpec"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Rsol", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"FindRoot", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"FNumVal", "[", "R", "]"}], "==", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"R", ",", "0.5"}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"Method", "->", "\"\<Secant\>\""}], ",", " ", 
           RowBox[{"WorkingPrecision", "->", "20"}], ",", 
           RowBox[{"AccuracyGoal", "->", "8"}], ",", 
           RowBox[{"PrecisionGoal", "->", "8"}], ",", 
           RowBox[{"MaxIterations", "->", "100"}]}], "\[IndentingNewLine]", 
          "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"csol", "=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"c", "->", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              FractionBox[
               RowBox[{"r", " ", "R", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  FractionBox["R", "k"]}], ")"}]}], 
               RowBox[{"R", " ", 
                RowBox[{"Int1", "[", 
                 RowBox[{
                 "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",",
                   "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",",
                   "\[Sigma]"}], "]"}]}]], ")"}], "/.", "paramsSpec"}], 
            ")"}]}], "/.", "Rsol"}], "}"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"R", ",", "c"}], "}"}], "/.", 
        RowBox[{"Join", "[", 
         RowBox[{"Rsol", ",", "csol"}], "]"}]}]}]}], "\[IndentingNewLine]", 
     "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DetTr", "[", 
     RowBox[{
      RowBox[{"dval_", "?", "NumericQ"}], ",", 
      RowBox[{"\[Sigma]val_", "?", "NumericQ"}], ",", "sol_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Rsol", ",", "csol", ",", "paramsSpec", ",", "JacobiAtEq"}], 
       "}"}], ",", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Rsol", "=", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"csol", "=", 
        RowBox[{"sol", "[", 
         RowBox[{"[", "2", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"paramsSpec", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"paramsGen", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"a", "->", 
             RowBox[{"X", "-", "dval"}]}], ",", 
            RowBox[{"h", "->", 
             RowBox[{"X", "-", "dval"}]}], ",", 
            RowBox[{"\[Sigma]", "->", "\[Sigma]val"}]}], "}"}]}], "]"}]}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"JacobiAtEq", "=", 
        RowBox[{
         RowBox[{"{", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"r", 
               RowBox[{"(", 
                RowBox[{"1", "-", 
                 FractionBox[
                  RowBox[{"2", "R"}], "k"]}], ")"}]}], "-", 
              RowBox[{"c", " ", 
               RowBox[{"Int2", "[", 
                RowBox[{
                "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                 "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                 "\[Sigma]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"-", "R"}], " ", 
              RowBox[{"Int1", "[", 
               RowBox[{
               "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                "\[Sigma]"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"\[Epsilon]", " ", "c", " ", 
              RowBox[{"Int2", "[", 
               RowBox[{
               "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                "\[Sigma]"}], "]"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"\[Epsilon]", " ", "R", " ", 
               RowBox[{"Int1", "[", 
                RowBox[{
                "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                 "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                 "\[Sigma]"}], "]"}]}], "-", "\[Beta]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "}"}], "/.", 
         RowBox[{"Join", "[", 
          RowBox[{"paramsSpec", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"R", "->", "Rsol"}], ",", 
             RowBox[{"c", "->", "csol"}]}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Det", "[", "JacobiAtEq", "]"}], ",", 
         RowBox[{"Tr", "[", "JacobiAtEq", "]"}]}], "}"}]}]}], 
     "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Classifying", "[", 
      RowBox[{
       RowBox[{"dval_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]val_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", ",", "coeffs"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sol", "=", 
         RowBox[{"EqSol", "[", 
          RowBox[{"dval", ",", "\[Sigma]val"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"VectorQ", "[", 
            RowBox[{"sol", ",", "NumericQ"}], "]"}], "&&", 
           RowBox[{
            RowBox[{"sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"sol", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"True", ":", " ", "coexistence"}], "*)"}], 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"coeffs", "=", 
            RowBox[{"DetTr", "[", 
             RowBox[{"dval", ",", "\[Sigma]val", ",", "sol"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Which", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], ",", "0", 
             RowBox[{"(*", "noncoexistence", "*)"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ">=", "0"}], "&&", 
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], "&&", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"coeffs", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "-", 
                RowBox[{"4", 
                 RowBox[{"coeffs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], ">=", "0"}]}], ",", "1",
              ",", 
             RowBox[{"(*", "nonoscillatory", "*)"}], "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ">=", "0"}], "&&", 
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], "&&", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"coeffs", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "-", 
                RowBox[{"4", 
                 RowBox[{"coeffs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], "<", "0"}]}], ",", "2", 
             ",", 
             RowBox[{"(*", 
              RowBox[{"damped", " ", "oscillations"}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "1", "]"}], "]"}], ">=", "0"}], "&&", 
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "2", "]"}], "]"}], ">=", "0"}]}], ",", "3"}], 
            RowBox[{"(*", 
             RowBox[{"limit", " ", "cycles"}], "*)"}], "\[IndentingNewLine]", 
            "]"}]}], ",", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"False", ":", " ", "noncoexistence"}], "*)"}], 
          "\[IndentingNewLine]", "0"}], "\[IndentingNewLine]", "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.972456825364435*^9, 3.9724568257343597`*^9}},
 CellLabel->"In[49]:=",ExpressionUUID->"a890182b-a7e2-9b41-93b0-86b206245360"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Trajectory with increasing concentration", "Section",
 CellChangeTimes->{{3.972456857957096*^9, 
  3.9724568668014336`*^9}},ExpressionUUID->"39b91af8-d04e-2045-9eea-\
7fd506a5d590"],

Cell[TextData[{
 "Let\[CloseCurlyQuote]s start with the no-pesticide case. We consider that \
the ecosystem is well-adapted, with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["d", "\[Alpha]"], "=", 
    RowBox[{
     SubscriptBox["d", "\[Eta]"], "=", 
     RowBox[{"d", "=", "0"}]}]}], TraditionalForm]],ExpressionUUID->
  "ca1b340a-6b99-684e-ad07-163400a6a714"],
 ". We\[CloseCurlyQuote]ll consider the same parameters as before (",
 Cell[BoxData[
  FormBox[
   RowBox[{"r", "=", "0.3"}], TraditionalForm]],ExpressionUUID->
  "7d8f5186-e6cd-8049-a89c-3551486a7052"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Alpha]", "=", "2"}], TraditionalForm]],ExpressionUUID->
  "bea94ccd-6be0-2e4b-baa1-459233ccf558"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", "max"], "=", "2"}], TraditionalForm]],
  ExpressionUUID->"73341d6a-0a65-7143-a4d8-3767b1fce9e6"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", "min"], "=", "1"}], TraditionalForm]],
  ExpressionUUID->"6ff138a3-85ad-9b44-b838-d5e9cbd99efb"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Epsilon]", "=", "0.5"}], TraditionalForm]],ExpressionUUID->
  "c8c0e09a-5be3-0f41-aab9-f01c3e9a1d40"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Tau]", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "72ec0deb-22ae-a149-9377-b2b5fff69c30"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Nu]", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "829dc4b6-80fc-be47-94f9-0a3a031b7fe3"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"k", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "39294790-c7bd-9646-a4ae-bcafdf23e352"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", "0.1"}], TraditionalForm]],ExpressionUUID->
  "56ae3878-6377-dd4c-afe7-fc38bad431bb"],
 "), with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["x", "TI"], "_"], "\[LongEqual]", "2.5"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\bar{x}=2.5", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "71867332-0be5-9448-902c-0571f2886ead"],
 " (arbitrary) and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "=", "1"}], TraditionalForm]],ExpressionUUID->
  "93bea9bd-5e1c-3040-9fc4-02d5a22b85f4"],
 ". Applying a non-zero concentration will change the population \
distribution, but not the parameters. Thus, when ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "15065bd0-34da-6648-98e2-1ebf96be1130"],
 " starts to decay, ",
 Cell[BoxData[
  FormBox["d", TraditionalForm]],ExpressionUUID->
  "31a42772-78a6-494d-b7c7-b2c7e501b9cc"],
 " will start to increase, along with a modification of \[Sigma]."
}], "Text",
 CellChangeTimes->{{3.9724568760008335`*^9, 3.9724573135631657`*^9}, {
  3.972467719524124*^9, 
  3.972467719524124*^9}},ExpressionUUID->"cc24a0a6-f326-6b45-8c8f-\
d3043bd4246e"],

Cell[CellGroupData[{

Cell["Computing the dose-response of our population", "Subsubsection",
 CellChangeTimes->{{3.9724574531755486`*^9, 
  3.9724574620977707`*^9}},ExpressionUUID->"88c57d8f-1393-f643-ac5e-\
a26442a4259e"],

Cell["Let\[CloseCurlyQuote]s start by applying what we did to this system", \
"Text",
 CellChangeTimes->{{3.9724574675949726`*^9, 
  3.9724574871311264`*^9}},ExpressionUUID->"2dc033de-a197-8d41-99a6-\
64a25c131cbb"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"x0", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"beta", "=", 
   RowBox[{"-", "0.5"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Dose", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"0", ",", "5", ",", "0.05"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"NEC", "=", "1.25"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baseline", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", 
       RowBox[{"DRFunLogExp", "[", 
        RowBox[{"d", ",", "x0", ",", "beta", ",", "NEC"}], "]"}]}], "}"}], ",",
      "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"d", ",", "Dose"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baselinePlot", "=", 
   RowBox[{"plotBaseline", "[", "baseline", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nID", "=", "10000"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"CVx", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"CVnec", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoX0NEC", "=", "0.9"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"individualsPos", "=", 
   RowBox[{"GenerateIndividuals", "[", 
    RowBox[{
    "x0", ",", "NEC", ",", "CVx", ",", "CVnec", ",", "rhoX0NEC", ",", "nID"}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"individualsNeg", "=", 
   RowBox[{"GenerateIndividuals", "[", 
    RowBox[{"x0", ",", "NEC", ",", "CVx", ",", "CVnec", ",", 
     RowBox[{"-", "rhoX0NEC"}], ",", "nID"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"individualsNull", "=", 
   RowBox[{"GenerateIndividuals", "[", 
    RowBox[{
    "x0", ",", "NEC", ",", "CVx", ",", "CVnec", ",", "0", ",", "nID"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"listPlot", ",", "histogram"}], "}"}], "=", 
   RowBox[{"plotDistrib", "[", 
    RowBox[{
    "individualsPos", ",", "individualsNeg", ",", "individualsNull", ",", 
     "colPos", ",", "colNeg"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sigma", "=", "0.08"}], ";"}], "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Positive", " ", "covariance", " ", "between", " ", "alpha", " ", "and", " ",
     "NEC"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"summaryPos", "=", 
    RowBox[{"SimulateDoseResponse", "[", "individualsPos", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "Negative", " ", "covariance", " ", "between", " ", "alpha", " ", "and", " ",
     "NEC"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"summaryNeg", "=", 
    RowBox[{"SimulateDoseResponse", "[", "individualsNeg", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "No", " ", "correlation", " ", "between", " ", "alpha", " ", "and", " ", 
    "NEC"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"summaryNull", "=", 
    RowBox[{"SimulateDoseResponse", "[", "individualsNull", "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Concentration", ",", " ", 
    RowBox[{
    "mean", " ", "Table", " ", "for", " ", "each", " ", "population"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanPos", "=", 
   RowBox[{
    RowBox[{"summaryPos", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatMean\>\"", "]"}]}], "}"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"meanNeg", "=", 
   RowBox[{
    RowBox[{"summaryNeg", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatMean\>\"", "]"}]}], "}"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"meanNull", "=", 
    RowBox[{
     RowBox[{"summaryNull", "[", 
      RowBox[{"[", "All", "]"}], "]"}], "/.", 
     RowBox[{"assoc_Association", ":>", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
        RowBox[{"assoc", "[", "\"\<yhatMean\>\"", "]"}]}], "}"}]}]}]}], ";"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Concentration", ",", " ", 
    RowBox[{
    "standard", " ", "deviation", " ", "for", " ", "each", " ", 
     "population"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stdPos", "=", 
   RowBox[{
    RowBox[{"summaryPos", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatSD\>\"", "]"}]}], "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stdNeg", "=", 
   RowBox[{
    RowBox[{"summaryNeg", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatSD\>\"", "]"}]}], "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"stdNull", "=", 
   RowBox[{
    RowBox[{"summaryNull", "[", 
     RowBox[{"[", "All", "]"}], "]"}], "/.", 
    RowBox[{"assoc_Association", ":>", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
       RowBox[{"assoc", "[", "\"\<yhatSD\>\"", "]"}]}], "}"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fullPlot", "=", 
   RowBox[{"plotResponse", "[", 
    RowBox[{
    "meanPos", ",", "meanNeg", ",", "meanNull", ",", "stdPos", ",", "stdNeg", 
     ",", "stdNull", ",", "0.2", ",", "colPos", ",", "colNeg"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", "baselinePlot", "\[IndentingNewLine]", \
"listPlot", "\[IndentingNewLine]", "histogram", "\[IndentingNewLine]", \
"fullPlot"}], "Input",
