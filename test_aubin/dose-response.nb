Cell[CellGroupData[{

Cell["Trajectories for varying dose", "Subsubsection",
 CellChangeTimes->{{3.9724659432381573`*^9, 
  3.9724659579301853`*^9}},ExpressionUUID->"f04034f8-b54f-7d44-b835-\
529f6ddc2ab7"],

Cell["\<\
Let\[CloseCurlyQuote]s compute the stability for varying pesticide exposition:\
\>", "Text",
 CellChangeTimes->{{3.9724660771709538`*^9, 3.972466120427183*^9}, {
  3.9724662220350285`*^9, 3.972466235776943*^9}, {3.9724673055781593`*^9, 
  3.9724673074092197`*^9}},ExpressionUUID->"2a136112-d0c6-3544-a4cd-\
6973590ab4bf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"sigmaPos", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"std", ",", 
     RowBox[{"{", 
      RowBox[{"std", ",", 
       RowBox[{"stdPos", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dvalsPos", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"x0", "-", "mean"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"mean", ",", 
       RowBox[{"meanPos", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"idMaxPos", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{"dvalsPos", ",", 
       RowBox[{
        RowBox[{
         RowBox[{"#", ">", "2.5"}], "&"}], "->", "\"\<Index\>\""}]}], "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}], "-", "1"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"coordsPos", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"sigmaPos", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", 
       RowBox[{"dvalsPos", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Range", "[", "idMaxPos", "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sigmaNeg", "=", 
   RowBox[{"Table", "[", 
    RowBox[{"std", ",", 
     RowBox[{"{", 
      RowBox[{"std", ",", 
       RowBox[{"stdNeg", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dvalsNeg", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"x0", "-", "mean"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"mean", ",", 
       RowBox[{"meanNeg", "[", 
        RowBox[{"[", 
