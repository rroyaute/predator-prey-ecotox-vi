Cell[TextData[{
 "Let\[CloseCurlyQuote]s first generate all 10000 individuals, one set with \
positive correlation between ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "583d7987-854c-4a4e-b594-28d6dcbfe50f"],
 " and NEC, another with negative correlation, and a last one with no \
correlation:"
}], "Text",
 CellChangeTimes->{
  3.9724556955558033`*^9},ExpressionUUID->"e2ad8457-23ce-b847-8179-\
3d068e9a3890"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"GenerateIndividuals", "[", 
   RowBox[{
   "x0_", ",", "NEC_", ",", "CVx_", ",", "CVnec_", ",", "rhoX0NEC_", ",", 
    "nID_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Mu", ",", "sigmas", ",", "rhoMat", ",", "Sigma", ",", "dist", ",", 
      "samples"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Mu", "=", 
      RowBox[{"{", 
       RowBox[{"x0", ",", "NEC"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sigmas", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"x0", "*", "CVx"}], ",", 
        RowBox[{"NEC", "*", "CVnec"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhoMat", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "rhoX0NEC"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"rhoX0NEC", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Sigma", "=", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", "sigmas", "]"}], ".", "rhoMat", ".", 
       RowBox[{"DiagonalMatrix", "[", "sigmas", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dist", "=", 
      RowBox[{"MultinormalDistribution", "[", 
       RowBox[{"Mu", ",", "Sigma"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"samples", "=", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{"dist", ",", "nID"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<x0\>\"", "->", 
          RowBox[{"samples", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<NEC\>\"", "->", 
          RowBox[{"samples", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<ID\>\"", "->", "i"}]}], "|>"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nID"}], "}"}]}], "\[IndentingNewLine]", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoX0NEC", "=", "0.9"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"individualsPos", "=", 
   RowBox[{"GenerateIndividuals", "[", 
    RowBox[{
    "x0", ",", "NEC", ",", "CVx", ",", "CVnec", ",", "rhoX0NEC", ",", "nID"}],
     "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"individualsNeg", "=", 
   RowBox[{"GenerateIndividuals", "[", 
    RowBox[{"x0", ",", "NEC", ",", "CVx", ",", "CVnec", ",", 
     RowBox[{"-", "rhoX0NEC"}], ",", "nID"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"individualsNull", "=", 
   RowBox[{"GenerateIndividuals", "[", 
    RowBox[{
    "x0", ",", "NEC", ",", "CVx", ",", "CVnec", ",", "0", ",", "nID"}], 
    "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9724576355909386`*^9, 3.972457665735176*^9}, {
  3.9724604702285213`*^9, 3.97246050446496*^9}, {3.9725375416635876`*^9, 
  3.9725376303906937`*^9}},
 CellLabel->"In[18]:=",ExpressionUUID->"ac9020de-9df8-c843-aa10-0b304a2b2d19"],

Cell["Here are the three populations distributions:", "Text",
 CellChangeTimes->{
  3.972455710210968*^9},ExpressionUUID->"ff896b31-cd72-dc43-8ea0-\
9b97945aeedf"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"colPos", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.01", ",", "0.39", ",", "0.57"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"colNeg", "=", 
   RowBox[{"RGBColor", "[", 
    RowBox[{"0.78", ",", "0.18", ",", "0.16"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plotDistrib", "[", 
   RowBox[{
   "individualsPos_", ",", "individualsNeg_", ",", "individualsNull_", ",", 
    "colPos_", ",", "colNeg_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "dataPos", ",", "dataNeg", ",", "dataNull", ",", "listPlot", ",", 
      "histogram"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"dataPos", "=", 
      RowBox[{
       RowBox[{"individualsPos", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
           RowBox[{"\"\<x0\>\"", ",", "\"\<NEC\>\""}], "}"}]}], "]"}], "]"}], 
       "/.", 
       RowBox[{"assoc_Association", ":>", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"assoc", "[", "\"\<x0\>\"", "]"}], ",", " ", 
          RowBox[{"assoc", "[", "\"\<NEC\>\"", "]"}]}], "}"}]}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dataNeg", "=", 
      RowBox[{
       RowBox[{"individualsNeg", "[", 
        RowBox[{"[", 
         RowBox[{"All", ",", 
          RowBox[{"{", 
