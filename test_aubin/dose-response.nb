Cell[CellGroupData[{

Cell["Dose-response simulations", "Chapter",
 CellChangeTimes->{
  3.9724552530310707`*^9},ExpressionUUID->"3bdea408-80b2-6044-95e4-\
f9f61e1eb62e"],

Cell[CellGroupData[{

Cell["Dose-response functions", "Section",
 CellChangeTimes->{
  3.9724552742653713`*^9},ExpressionUUID->"05108c1a-b507-4144-b02b-\
86b91d20f13d"],

Cell[TextData[{
 "Here are the defined the (individual) dose-response functions of a compound \
on a given parameter:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["y", "TI"], 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["y", "TI"], "0"], " if ", 
                    StyleBox["C", "TI"], "\[LessEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}]], "InlineFormula"]}]]}, {
                 Cell[
                  TextData[{
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["y", "TI"], "0"], 
                    SuperscriptBox[
                    StyleBox["e", "TI"], 
                    RowBox[{"-", "\[Beta]", 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["C", "TI"], "-", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}], ")"}]}]], " if ", 
                    StyleBox["C", "TI"], "\[GreaterEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}]], "InlineFormula"]}]]}}, 
               ColumnAlignments -> Left], TraditionalForm]]]}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "y(C)=\\left\\{\\begin{array}{l}y_0\\text{ if }C\\leq C_0\\\\y_0 \
e^{-\\beta (C-C_0)}\\text{ if }C\\geq C_0\\end{array}\\right.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "61d94fea-f61b-7e42-80bb-a74481d10c40"],
 "\nThe idea here is to investigate the impact of a pesticide on a \
predator-prey ecosystem, with the method developed in `method_jacob.nb`."
}], "Text",
 CellChangeTimes->{{3.9724552933315353`*^9, 
  3.972455312460451*^9}},ExpressionUUID->"54d1e218-61e0-a94a-b8cd-\
e06621cc81e9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"DRLogRNFun", ",", "DRFunLog", ",", "DRFunLogExp"}], "]"}], ";"}],
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_logRN", "_fun"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DRLogRNFun", "[", 
    RowBox[{"Dose_", ",", "Rmin_", ",", "Rmax_", ",", "beta_", ",", "NEC_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"logyhat", ",", "yhat"}], "}"}], ",", 
     RowBox[{
      RowBox[{"logyhat", "=", 
       RowBox[{"Rmin", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Rmax", "-", "Rmin"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Exp", "[", "beta", "]"}]}], "*", 
           RowBox[{"(", 
            RowBox[{"Dose", "-", "NEC"}], ")"}], "*", 
           RowBox[{"Boole", "[", 
            RowBox[{"Dose", ">", "NEC"}], "]"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"yhat", "=", 
       RowBox[{"Exp", "[", "logyhat", "]"}]}], ";", "\[IndentingNewLine]", 
      "yhat"}]}], "]"}]}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_fun", "_log"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"DRFunLog", "[", 
    RowBox[{"Dose_", ",", "alpha_", ",", "beta_", ",", "NEC_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log", "[", "alpha", "]"}], ",", 
        RowBox[{"Dose", "<", "NEC"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Log", "[", "alpha", "]"}], "-", 
         RowBox[{
          RowBox[{"Exp", "[", "beta", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"Dose", "-", "NEC"}], ")"}]}]}], ",", 
        RowBox[{"Dose", ">=", "NEC"}]}], "}"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_fun", "_log", "_exp"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"DRFunLogExp", "[", 
   RowBox[{"Dose_", ",", "alpha_", ",", "beta_", ",", "NEC_"}], "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"DRFunLog", "[", 
    RowBox[{"Dose", ",", "alpha", ",", "beta", ",", "NEC"}], "]"}], 
   "]"}]}]}], "Input",
 CellLabel->"In[1]:=",ExpressionUUID->"44e50dcd-de47-2649-8f6a-4caf2e2d06d4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dose-response simulations", "Section",
 CellChangeTimes->{
  3.972455330171383*^9},ExpressionUUID->"101b9316-d2fb-b14a-a284-\
c33c1c1a9e18"],

Cell[TextData[{
 "We will firstly generate a population of 10000 individuals, each with a \
phenotypic trait ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "8832d51d-af97-dd46-be40-ff4186dc622e"],
 " following a normal distribution around ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "64fab121-a645-c047-ac35-00c47c8c7a1d"],
 ", with standard deviation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],ExpressionUUID->
  "1cc84bdd-e614-5a49-abfc-d1ed66faa33d"],
 ".\nEach individual also has a different minimal pesticide concentration \
(NEC: No Effect Concentration) above which the trait ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "00a9ca67-f50d-8348-b936-6b0d33347fe0"],
 " decays to zero.\nFor a single individual, the dose-response function is:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["x", "TI"], 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["x", "TI"], "0"], " if ", 
                    StyleBox["C", "TI"], "\[LessEqual]", 
                    StyleBox["NEC", FontSlant -> "Plain"]}]], 
                    "InlineFormula"]}]]}, {
                 Cell[
                  TextData[{
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["x", "TI"], "0"], 
                    SuperscriptBox[
                    StyleBox["e", "TI"], 
                    RowBox[{"-", 
                    SuperscriptBox[
                    StyleBox["e", "TI"], "\[Beta]"], 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["C", "TI"], "-", 
                    StyleBox["NEC", FontSlant -> "Plain"]}], ")"}]}]], " if ", 
                    StyleBox["C", "TI"], "\[GreaterEqual]", 
                    StyleBox["NEC", FontSlant -> "Plain"]}]], 
                    "InlineFormula"]}]]}}, ColumnAlignments -> Left], 
              TraditionalForm]]]}]}], TraditionalForm], "errors" -> {}, 
     "input" -> 
     "x(C)=\\left\\{\\begin{array}{l}\nx_0\\text{ if }C\\leq\\mathrm{NEC}\\\\\
\nx_0 e^{-e^{\\beta}(C-\\mathrm{NEC})}\\text{ if }C\\geq\\mathrm{NEC}\n\
\\end{array}\\right.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c57395a6-260b-aa4f-81d2-43f408c9d71c"],
 "\nHere, we\[CloseCurlyQuote]ll take ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["x", "TI"], "_"], "\[LongEqual]", "100"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\bar{x}=100", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "656e46a5-3c9d-b840-b183-4c1bb775f1e4"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sigma]", "\[LongEqual]", "0.2", "\[Cross]", 
         OverscriptBox[
          StyleBox["x", "TI"], "_"], "\[LongEqual]", "20"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\sigma=0.2\\times\\bar{x}=20", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "32fbcd72-1270-c94b-8d75-948d678d9039"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["NEC", FontSlant -> "Plain"], "_"], "\[LongEqual]", "25"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{\\mathrm{NEC}}=25", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "9ad58dfb-7757-604a-8aa9-312eef786103"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Sigma]", 
          StyleBox["NEC", FontSlant -> "Plain"]], "\[LongEqual]", "0.2", 
         "\[Cross]", 
         OverscriptBox[
          StyleBox["NEC", FontSlant -> "Plain"], "_"], "\[LongEqual]", "5"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma_{\\mathrm{NEC}}=0.2\\times\\bar{\\mathrm{NEC}}=5", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "5f417591-95f1-b949-82ec-f3440a3c9fbe"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          RowBox[{
            SubscriptBox[
             StyleBox["x", "TI"], "0"], ",", 
            StyleBox["NEC", FontSlant -> "Plain"]}]], "\[LongEqual]", "0", 
         " or ", "\[PlusMinus]", "0.9"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho_{x_0,\\mathrm{NEC}}=0\\text{ or }\\pm0.9", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c9a83cce-28cd-d24b-9129-add600261680"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             SubscriptBox[
              StyleBox["x", "TI"], "0"], ",", 
             StyleBox["NEC", FontSlant -> "Plain"]}], ")"}], "\[Tilde]", 
         StyleBox["M", "TI"], 
         StyleBox["V", "TI"], 
         StyleBox["N", "TI"], 
         RowBox[{"(", "\[CapitalSigma]", ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "(x_0,\\mathrm{NEC}})\\sim MV \\mathcal{N}(\\Sigma)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0eff7d2e-d5b9-1443-a974-cfda793d0de1"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalSigma]", "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"\[Sigma]", "0"},
        {"0", 
         SubscriptBox["\[Sigma]", "NEC"]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {"1", 
         SubscriptBox["\[Rho]", 
          RowBox[{
           SubscriptBox["x", "0"], ",", "NEC"}]]},
        {
         SubscriptBox["\[Rho]", 
          RowBox[{
           SubscriptBox["x", "0"], ",", "NEC"}]], "1"}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {"\[Sigma]", "0"},
        {"0", 
         SubscriptBox["\[Sigma]", "NEC"]}
       }], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "f0929668-28c0-5e4e-b958-f85d38738d34"],
 ".\nRemark: one could also consider an individual variation of ",
 Cell[BoxData[
  FormBox["\[Beta]", TraditionalForm]],ExpressionUUID->
  "e07d6a84-b94d-9149-b40e-45499989c3d4"],
 ", but in practice, this is difficult to measure, as one individual can only \
be used once for measurement (destructive measurements)."
}], "Text",
 CellChangeTimes->{{3.9724553521513786`*^9, 3.9724554599987755`*^9}, {
  3.9724556291743145`*^9, 3.9724556340422935`*^9}, {3.9724575734021416`*^9, 
  3.972457583194353*^9}},ExpressionUUID->"8576f592-61d5-3d4a-9d84-\
3bdd5be94004"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "GLOBAL"}]}], " ", 
     RowBox[{"PARAMETERS", " ", "--"}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"x0", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta", "=", 
     RowBox[{"-", "3.5"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Dose", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "100", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"NEC", "=", "25"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nID", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CVx", "=", "0.2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CVnec", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sigma", "=", "0.08"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9724575946282444`*^9, 3.972457596032692*^9}, {
   3.9724622831206036`*^9, 3.972462284555868*^9}, 3.972464544419548*^9, {
   3.9725375256158924`*^9, 3.972537533850006*^9}},
 CellLabel->"In[5]:=",ExpressionUUID->"329a1c6e-5f98-0b45-8da5-cf4080863a6f"],

Cell["Here is the individual dose-response function:", "Text",
 CellChangeTimes->{
  3.9724554726635113`*^9},ExpressionUUID->"06fedf89-9811-5645-aa62-\
b2d352733910"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"DRFunLogExp", "[", 
       RowBox[{"d", ",", "X0", ",", "\[Beta]", ",", "nec"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", "0", ",", "100"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"X0", ",", "x0"}], "}"}], ",", "10", ",", " ", "200"}], "}"}], 
    ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", "beta"}], "}"}], ",", 
      RowBox[{"-", "10"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nec", ",", "NEC"}], "}"}], ",", "5", ",", "80"}], "}"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"FrameLabel", "->", 
     RowBox[{"{", 
