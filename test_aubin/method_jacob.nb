Cell["\<\
Let\[CloseCurlyQuote]s move on to adding a pesticide concentration, and \
computing the response of the predator-prey system.\
\>", "Text",
 CellChangeTimes->{{3.971414545137001*^9, 
  3.9714145653152103`*^9}},ExpressionUUID->"3761bd9c-3630-d741-b904-\
e0b48d5652ac"],

Cell[CellGroupData[{

Cell["Dose-response functions", "Section",
 CellChangeTimes->{{3.971414534835203*^9, 
  3.971414538599411*^9}},ExpressionUUID->"6dd3eae3-5b00-f04b-a9b4-\
59cf9db8dae5"],

Cell[TextData[{
 "Here are the defined the (individual) dose-response functions of a compound \
on a given parameter:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["y", "TI"], 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["y", "TI"], "0"], " if ", 
                    StyleBox["C", "TI"], "\[LessEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}]], "InlineFormula"]}]]}, {
                 Cell[
                  TextData[{
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["y", "TI"], "0"], 
                    SuperscriptBox[
                    StyleBox["e", "TI"], 
                    RowBox[{"-", "\[Beta]", 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["C", "TI"], "-", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}], ")"}]}]], " if ", 
                    StyleBox["C", "TI"], "\[GreaterEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}]], "InlineFormula"]}]]}}, 
               ColumnAlignments -> Left], TraditionalForm]]]}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "y(C)=\\left\\{\\begin{array}{l}y_0\\text{ if }C\\leq C_0\\\\y_0 \
e^{-\\beta (C-C_0)}\\text{ if }C\\geq C_0\\end{array}\\right.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "425cabc8-3491-ce45-b7fd-8a82e5adf99e"],
 "\nThe idea here is to investigate the impact of a pesticide on a \
predator-prey ecosystem."
}], "Text",
 CellChangeTimes->{{3.971421552044859*^9, 3.9714216378612194`*^9}, {
  3.9714218192187996`*^9, 
  3.9714219044166183`*^9}},ExpressionUUID->"5beaf01a-af62-b141-8b4f-\
74d329be93e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"DRLogRNFun", ",", "DRFunLog", ",", "DRFunLogExp"}], "]"}], ";"}],
   "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_logRN", "_fun"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DRLogRNFun", "[", 
    RowBox[{"Dose_", ",", "Rmin_", ",", "Rmax_", ",", "beta_", ",", "NEC_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"logyhat", ",", "yhat"}], "}"}], ",", 
     RowBox[{
      RowBox[{"logyhat", "=", 
       RowBox[{"Rmin", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Rmax", "-", "Rmin"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Exp", "[", "beta", "]"}]}], "*", 
           RowBox[{"(", 
            RowBox[{"Dose", "-", "NEC"}], ")"}], "*", 
           RowBox[{"Boole", "[", 
            RowBox[{"Dose", ">", "NEC"}], "]"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"yhat", "=", 
       RowBox[{"Exp", "[", "logyhat", "]"}]}], ";", "\[IndentingNewLine]", 
      "yhat"}]}], "]"}]}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_fun", "_log"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DRFunLog", "[", 
    RowBox[{"Dose_", ",", "alpha_", ",", "beta_", ",", "NEC_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log", "[", "alpha", "]"}], ",", 
        RowBox[{"Dose", "<", "NEC"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Log", "[", "alpha", "]"}], "-", 
         RowBox[{
          RowBox[{"Exp", "[", "beta", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"Dose", "-", "NEC"}], ")"}]}]}], ",", 
        RowBox[{"Dose", ">=", "NEC"}]}], "}"}]}], "}"}], "]"}]}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_fun", "_log", "_exp"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DRFunLogExp", "[", 
   RowBox[{"Dose_", ",", "alpha_", ",", "beta_", ",", "NEC_"}], "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"DRFunLog", "[", 
    RowBox[{"Dose", ",", "alpha", ",", "beta", ",", "NEC"}], "]"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.971414576729849*^9, 3.971414576729849*^9}},
 CellLabel->
  "In[1281]:=",ExpressionUUID->"43394746-549f-ff43-b28f-63752ed2e5b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dose-response simulations", "Section",
 CellChangeTimes->{{3.9714145969645824`*^9, 
  3.9714146007886505`*^9}},ExpressionUUID->"95a8c983-6913-c544-a723-\
ac5a3f645270"],

Cell[TextData[{
 "We will firstly generate a population of 10000 individuals, each with a \
different attack rate ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e1af910-1cfb-ec4b-9fa0-274627962072"],
 ".\nEach individual also has a different minimal pesticide concentration \
above which the attack rate starts to decay.\nThe deviation among the \
population is of ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"0.2", "\[Cross]"}], TraditionalForm], "errors" -> {}, "input" -> 
     "0.2\\times", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "beeeb4f2-0290-124c-898e-a66cb7c7edd1"],
 "the mean."
}], "Text",
 CellChangeTimes->{{3.9714219178079414`*^9, 3.971421994826397*^9}, {
  3.971422213642174*^9, 3.9714222377634163`*^9}, {3.9714224302834206`*^9, 
  3.97142246337624*^9}},ExpressionUUID->"22016717-3f2c-1a47-9b3a-\
dfe1d3885feb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "GLOBAL"}]}], " ", 
     RowBox[{"PARAMETERS", " ", "--"}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"alpha", "=", "100"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"beta", "=", 
     RowBox[{"-", "3.5"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Dose", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "100", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"NEC", "=", "25"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"nID", "=", "10000"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"CVi", "=", "0.2"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"sigma", "=", "0.08"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.971414607534115*^9, 3.971414645406639*^9}, {
   3.9714146793935337`*^9, 3.971414894268175*^9}, {3.971414947014696*^9, 
   3.9714150757918377`*^9}, {3.9714151382775307`*^9, 3.9714151418066006`*^9}, 
   3.971422489869503*^9, {3.971422525233917*^9, 3.9714225284584465`*^9}, {
   3.9714298303127384`*^9, 3.9714298304220448`*^9}, {3.9714300186304836`*^9, 
   3.9714300235896072`*^9}},ExpressionUUID->"d313ae70-ed20-5c48-80be-\
1569cff10a18"],

Cell["Here is the individual dose-response function:", "Text",
 CellChangeTimes->{{3.9714225018061657`*^9, 
  3.9714225201437225`*^9}},ExpressionUUID->"95857876-a8ec-a349-a040-\
87111a321a6c"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Manipulate", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"DRFunLogExp", "[", 
       RowBox[{"d", ",", "\[Alpha]", ",", "\[Beta]", ",", "Cmax"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"d", ",", "0", ",", "100"}], "}"}]}], "]"}], ",", 
    "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Alpha]", ",", "alpha"}], "}"}], ",", "10", ",", " ", 
      "200"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[Beta]", ",", "beta"}], "}"}], ",", 
      RowBox[{"-", "10"}], ",", 
      RowBox[{"-", "1"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Cmax", ",", "NEC"}], "}"}], ",", "5", ",", "80"}], "}"}]}], 
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Check", " ", "the", " ", "baseline", " ", "deterministic", " ", "dose"}],
     "\[Dash]", 
    RowBox[{"response", " ", "function"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"baseline", "=", 
   RowBox[{"Table", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"d", ",", 
       RowBox[{"DRFunLogExp", "[", 
        RowBox[{"d", ",", "alpha", ",", "beta", ",", "NEC"}], "]"}]}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{"{", 
      RowBox[{"d", ",", "Dose"}], "}"}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"ListLinePlot", "[", "baseline", "]"}]}], "Input",
 CellChangeTimes->{{3.9714225469298935`*^9, 3.9714225470891685`*^9}, {
  3.971429821433975*^9, 3.9714298438117523`*^9}},
 CellLabel->
  "In[1292]:=",ExpressionUUID->"5b16c707-1c6e-8141-86ff-dc150fe8efb3"],

