                 "\[Sigma]"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[CurlyEpsilon]", " ", "c", " ", 
               RowBox[{"Int2", "[", 
                RowBox[{
                "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                 "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                 "\[Sigma]"}], "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"\[CurlyEpsilon]", " ", "R", " ", 
                RowBox[{"Int1", "[", 
                 RowBox[{
                 "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",",
                   "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",",
                   "\[Sigma]"}], "]"}]}], "-", "\[Beta]"}]}], "}"}]}], 
           "\[IndentingNewLine]", "}"}], "/.", " ", "paramsSpec"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Det", "[", "J", "]"}], ",", 
          RowBox[{"Tr", "[", "J", "]"}]}], "}"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "CLASSIFICATION"}]}], " ", 
      RowBox[{"FUNCTION", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "Classifying", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Classifying", "[", 
      RowBox[{
       RowBox[{"dval_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]val_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", ",", "coeffs"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"sol", "=", 
         RowBox[{"Quiet", "[", 
          RowBox[{"EqSol", "[", 
           RowBox[{"dval", ",", "\[Sigma]val"}], "]"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"VectorQ", "[", 
            RowBox[{"sol", ",", "NumericQ"}], "]"}], "&&", 
           RowBox[{
            RowBox[{"sol", "[", 
             RowBox[{"[", "1", "]"}], "]"}], ">", "0"}], "&&", 
           RowBox[{
            RowBox[{"sol", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ">", "0"}]}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"coeffs", "=", 
            RowBox[{"DetTr", "[", 
             RowBox[{"dval", ",", "\[Sigma]val", ",", "sol"}], "]"}]}], ";", 
           "\[IndentingNewLine]", 
           RowBox[{"Which", "[", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", "1", "]"}], "]"}], "<", "0"}], ",", "0", ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"instability", "/", "no"}], " ", "coexistence"}], 
              "*)"}], "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], "&&", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"coeffs", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "-", 
                RowBox[{"4", " ", 
                 RowBox[{"coeffs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], ">=", "0"}]}], ",", "1",
              ",", 
             RowBox[{"(*", 
              RowBox[{"stable", " ", "nonoscillatory"}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{
               RowBox[{"coeffs", "[", 
                RowBox[{"[", "2", "]"}], "]"}], "<", "0"}], "&&", 
              RowBox[{
               RowBox[{
                RowBox[{
                 RowBox[{"coeffs", "[", 
                  RowBox[{"[", "2", "]"}], "]"}], "^", "2"}], "-", 
                RowBox[{"4", " ", 
                 RowBox[{"coeffs", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}]}], "<", "0"}]}], ",", "2", 
             ",", 
             RowBox[{"(*", 
              RowBox[{"damped", " ", "oscillations"}], "*)"}], 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"coeffs", "[", 
               RowBox[{"[", "2", "]"}], "]"}], ">", "0"}], ",", "3", ",", 
             RowBox[{"(*", 
              RowBox[{"limit", " ", "cycles"}], "*)"}], "\[IndentingNewLine]",
              "True", ",", "0"}], "]"}]}], ",", "\[IndentingNewLine]", "0"}], 
         "]"}]}]}], "\[IndentingNewLine]", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "PARALLEL"}]}], " ", 
      RowBox[{"SCAN", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"dvals", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.01", ",", "2.5", ",", "0.02"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Sigma]vals", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0.01", ",", "6", ",", "0.05"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "Int1", ",", "Int2", ",", "EqSol", ",", "DetTr", ",", "Classifying", ",",
       "cAttack", ",", "cHandling", ",", "cPdist", ",", "paramsGen", ",", 
      "X"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"LaunchKernels", "[", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"resultGrid", "=", 
     RowBox[{"ParallelTable", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"Classifying", "[", 
        RowBox[{"d", ",", "\[Sigma]"}], "]"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"d", ",", "dvals"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\[Sigma]", ",", "\[Sigma]vals"}], "}"}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", 
       RowBox[{"PLOT", "--"}]}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"leg", "=", 
     RowBox[{"SwatchLegend", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"Black", ",", "White", ",", "LightGray", ",", "Gray"}], "}"}],
        ",", "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"\"\<Noncoexistence\>\"", 
         ",", "\"\<Coexistence: nonoscillatory\>\"", 
         ",", "\"\<Coexistence: damped oscillations\>\"", 
         ",", "\"\<Coexistence: limit cycles\>\""}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"LegendMarkers", "->", "\"\<Rectangle\>\""}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"Legended", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"ArrayPlot", "[", 
      RowBox[{"resultGrid", ",", "\[IndentingNewLine]", 
       RowBox[{"DataReversed", "->", "True"}], ",", "\[IndentingNewLine]", 
