Cell[TextData[{
 StyleBox["Comment on the left of the plot.\n",
  FontWeight->"Bold"],
 "On the original figure, there\[CloseCurlyQuote]s no black going down on the \
left (noncoexistence for low phenotypic mismatch when individual variation is \
low).\nHowever, when ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Sigma]", "->", "0"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0f56843d-9d12-1f44-b969-32b4c841190c"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["p", "TI"], 
         RowBox[{"(", 
           StyleBox["x", "TI"], ")"}], "\[LongRightArrow]", "\[Delta]", 
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], "-", 
             OverscriptBox[
              StyleBox["x", "TI"], "_"]}], ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> "p(x)\\longrightarrow \\delta(x-\\bar{x})", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83aa6cd9-8d67-e246-9909-43014d34648b"],
 ", meaning the interaction term ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[LongRightArrow]", 
         FractionBox[
          RowBox[{
            SubscriptBox["\[Alpha]", 
             StyleBox["max", FontSlant -> "Plain"]], 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{"-", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["d", "TI"], "2"], 
                RowBox[{"2", 
                  SuperscriptBox["\[Tau]", "2"]}]]}]]}], 
          RowBox[{"1", "+", 
            StyleBox["R", "TI"], 
            SubscriptBox["\[Alpha]", 
             StyleBox["max", FontSlant -> "Plain"]], 
            SuperscriptBox[
             StyleBox["e", "TI"], 
             RowBox[{"-\.08", 
               FractionBox[
                SuperscriptBox[
                 StyleBox["d", "TI"], "2"], 
                RowBox[{"2", 
                  SuperscriptBox["\[Tau]", "2"]}]]}]], 
            RowBox[{"[", 
              RowBox[{
                SubscriptBox["\[Eta]", 
                 StyleBox["max", FontSlant -> "Plain"]], "-", 
                RowBox[{"(", 
                  RowBox[{
                    SubscriptBox["\[Eta]", 
                    StyleBox["max", FontSlant -> "Plain"]], "-", 
                    SubscriptBox["\[Eta]", 
                    StyleBox["min", FontSlant -> "Plain"]]}], ")"}], 
                SuperscriptBox[
                 StyleBox["e", "TI"], 
                 RowBox[{"-", 
                   FractionBox[
                    SuperscriptBox[
                    StyleBox["d", "TI"], "2"], 
                    RowBox[{"2", 
                    SuperscriptBox["\[Nu]", "2"]}]]}]]}], "]"}]}]]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\longrightarrow\\frac{\\alpha_{\\mathrm{max}}e^{-\\frac{d^2}{2\\tau^2}}\
}{1+R\\alpha_{\\mathrm{max}}e^{-\.08\\frac{d^2}{2\\tau^2}}\\Big[\\eta_{\\\
mathrm{max}}-(\\eta_{\\mathrm{max}}-\\eta_{\\mathrm{min}})e^{-\\frac{d^2}{2\\\
nu^2}}\\Big]}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "4c728f26-cc55-a042-843d-5096412b4ab1"],
 Cell[BoxData[
  FormBox[
   RowBox[{Cell["~",ExpressionUUID->"57227016-6376-8745-8674-813adc2a198f"], 
    TemplateBox[<|"boxes" -> FormBox[
        RowBox[{"\[NonBreakingSpace]", 
          SubscriptBox["\[Alpha]", 
           StyleBox["max", FontSlant -> "Plain"]], 
          SuperscriptBox[
           StyleBox["e", "TI"], 
           RowBox[{"-", 
             FractionBox[
              SuperscriptBox[
               StyleBox["d", "TI"], "2"], 
              RowBox[{"2", 
                SuperscriptBox["\[Tau]", "2"]}]]}]]}], TraditionalForm], 
      "errors" -> {}, "input" -> 
      "~\\alpha_{\\mathrm{max}}e^{-\\frac{d^2}{2\\tau^2}}", "state" -> 
      "Boxes"|>,
     "TeXAssistantTemplate"]}], TraditionalForm]],ExpressionUUID->
  "6a5d0a40-c253-504b-a1bf-a6ef3f80b4fe"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[GreaterGreater]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d\\gg 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "153b9f25-0fcd-b44e-9412-bf7603f69f96"],
 ", but ~ ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         FractionBox[
          SubscriptBox["\[Alpha]", 
           StyleBox["max", FontSlant -> "Plain"]], 
          RowBox[{"1", "+", 
            StyleBox["R", "TI"], 
            SubscriptBox["\[Alpha]", 
             StyleBox["max", FontSlant -> "Plain"]], 
            SubscriptBox["\[Eta]", 
             StyleBox["min", FontSlant -> "Plain"]]}]], "\[NotEqual]", "0"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\frac{\\alpha_{\\mathrm{max}}}{1+R\\alpha_{\\mathrm{max}}\\eta_{\\\
mathrm{min}}}\\neq 0", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "c4a4f873-9d17-4443-a60b-6aa22d4f2f7d"],
 " for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["d", "TI"], "\[LessLess]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "d\\ll 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e73e83c8-82d8-eb40-a5d1-5a17314ab635"],
 ", which is a classical Rosenzweig-MacArthur model.\nFor the values used, \
this should be in the \[OpenCurlyDoubleQuote]coexistence: limit cycles\
\[CloseCurlyDoubleQuote] regime (cf. `test.nb` for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Beta]", "=", "0.1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "bc24ece0-b2d0-1746-9e74-49c006060b3d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Eta]", "=", "1"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "9cd0e19b-9c1e-0b49-b4b9-b663beb2e9e1"],
 "). This is what\[CloseCurlyQuote]s shown on the original figure and on the \
classical computational method used first in this notebook, but that shows \
that the fast method doesn\[CloseCurlyQuote]t work for ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sigma]", "\[LessLess]", "1"}], TraditionalForm], 
     "errors" -> {}, "input" -> "\\sigma\\ll 1", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0f451bdd-029d-bb4f-81f3-1d95e299ba54"],
 ". I still have to figure out why"
}], "Text",
 CellChangeTimes->{{3.969948573587055*^9, 3.9699486656583633`*^9}, {
  3.969948717146492*^9, 3.969948772128414*^9}, {3.969948807279743*^9, 
  3.9699488087410755`*^9}, {3.9699488437361984`*^9, 3.9699488779691772`*^9}, {
  3.969962297688982*^9, 3.9699622990516605`*^9}, {3.9699623850836506`*^9, 
  3.9699624083120823`*^9}, {3.9699624579645042`*^9, 3.969962586264717*^9}, {
  3.969962625296791*^9, 3.969962635134968*^9}, {3.9699626711167107`*^9, 
  3.969962715833685*^9}, {3.969962774257244*^9, 3.9699628020493126`*^9}, {
  3.9699628385963917`*^9, 3.9699628487360497`*^9}, {3.9699628808922844`*^9, 
  3.9699629115725746`*^9}, {3.9699629486346073`*^9, 3.9699629522990265`*^9}, {
  3.96996298372093*^9, 3.969963012997814*^9}, {3.9699630562115*^9, 
  3.969963112735777*^9}, {3.9699633663340263`*^9, 3.9699633677654667`*^9}, {
  3.9699635227119064`*^9, 
  3.969963600933836*^9}},ExpressionUUID->"0b21e946-9428-4b43-beec-\
18da454d6992"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Consistency check with the first method", "Subsection",
 CellChangeTimes->{{3.9699537776073704`*^9, 
  3.9699537833877277`*^9}},ExpressionUUID->"24a60217-5e44-9349-a6fa-\
6b63e427bc1f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pdist", "[", 
    RowBox[{"x_", ",", "X_", ",", "\[Sigma]_"}], "]"}], ":=", 
   RowBox[{
    FractionBox["1", 
     SqrtBox[
      RowBox[{"2", "\[Pi]", " ", "\[Sigma]"}]]], 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "X"}], ")"}], "2"], 
       RowBox[{"2", "\[Sigma]"}]]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"attack", "[", 
    RowBox[{"x_", ",", "a_", ",", "\[Alpha]_", ",", "\[Tau]_"}], "]"}], ":=", 
   RowBox[{"\[Alpha]", " ", 
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"x", "-", "a"}], ")"}], "2"], 
       RowBox[{"2", 
        SuperscriptBox["\[Tau]", "2"]}]]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"handling", "[", 
    RowBox[{
    "x_", ",", "h_", ",", "\[Eta]min_", ",", "\[Eta]max_", ",", "\[Nu]_"}], 
    "]"}], ":=", 
   RowBox[{"\[Eta]max", "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Eta]max", "-", "\[Eta]min"}], ")"}], 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"-", 
       FractionBox[
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"x", "-", "h"}], ")"}], "2"], 
        RowBox[{"2", 
         SuperscriptBox["\[Nu]", "2"]}]]}]]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Int1", "[", 
    RowBox[{
     RowBox[{"R_", "?", "NumericQ"}], ",", 
     RowBox[{"a_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Tau]_", "?", "NumericQ"}], ",", 
     RowBox[{"h_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Eta]min_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Eta]max_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Nu]_", "?", "NumericQ"}], ",", 
     RowBox[{"X_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Sigma]_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"NIntegrate", "[", 
    RowBox[{
     RowBox[{
      FractionBox[
       RowBox[{"attack", "[", 
        RowBox[{"x", ",", "a", ",", "\[Alpha]", ",", "\[Tau]"}], "]"}], 
       RowBox[{"1", "+", 
        RowBox[{
         RowBox[{"attack", "[", 
          RowBox[{"x", ",", "a", ",", "\[Alpha]", ",", "\[Tau]"}], "]"}], 
         RowBox[{"handling", "[", 
          RowBox[{
          "x", ",", "h", ",", "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]"}], 
          "]"}], "R"}]}]], 
      RowBox[{"pdist", "[", 
       RowBox[{"x", ",", "X", ",", "\[Sigma]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Int2", "[", 
    RowBox[{
     RowBox[{"R_", "?", "NumericQ"}], ",", 
     RowBox[{"a_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Tau]_", "?", "NumericQ"}], ",", 
     RowBox[{"h_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Eta]min_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Eta]max_", "?", "NumericQ"}], ",", 
     RowBox[{"\[Nu]_", "?", "NumericQ"}], ",", 
     RowBox[{"X_", "?", "NumericQ"}], ",", 
