   RowBox[{
    RowBox[{
     RowBox[{"Int2", "[", 
      RowBox[{
       RowBox[{"R_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
       RowBox[{"a_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Tau]_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
       RowBox[{"h_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]min_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]max_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Nu]_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
       RowBox[{"X_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{
      RowBox[{"Int2", "[", 
       RowBox[{
       "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
        "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
        "\[Sigma]"}], "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xmin", "=", 
           RowBox[{"X", "-", 
            RowBox[{"7", " ", "\[Sigma]"}]}]}], ",", 
          RowBox[{"xmax", "=", 
           RowBox[{"X", "+", 
            RowBox[{"7", " ", "\[Sigma]"}]}]}]}], "}"}], ",", 
        "\[IndentingNewLine]", 
        RowBox[{"NIntegrate", "[", 
         RowBox[{
          RowBox[{"With", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"A", "=", 
               RowBox[{"cAttack", "[", 
                RowBox[{"x", ",", "a", ",", "\[Alpha]", ",", "\[Tau]"}], 
                "]"}]}], ",", 
              RowBox[{"H", "=", 
               RowBox[{"cHandling", "[", 
                RowBox[{
                "x", ",", "h", ",", "\[Eta]min", ",", "\[Eta]max", ",", 
                 "\[Nu]"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"A", "/", 
              RowBox[{"(", 
               RowBox[{"1", "+", 
                RowBox[{"A", " ", "H", " ", "R"}]}], ")"}]}], " ", 
             RowBox[{"cPdist", "[", 
              RowBox[{"x", ",", "X", ",", "\[Sigma]"}], "]"}], " ", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"A", " ", "H", " ", "R"}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"1", "+", 
                  RowBox[{"A", " ", "H", " ", "R"}]}], ")"}]}]}], ")"}]}]}], 
           "]"}], ",", "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], "]"}]}], 
