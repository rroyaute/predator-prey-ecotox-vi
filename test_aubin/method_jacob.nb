   "Positive", " ", "covariance", " ", "between", " ", "alpha", " ", "and", " ",
     "NEC"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"summaryPos", "=", 
     RowBox[{"SimulateDoseResponse", "[", "individualsPos", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
