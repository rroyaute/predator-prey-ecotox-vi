               "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                "\[Sigma]"}], "]"}]}], ",", "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"\[Epsilon]", " ", "R", " ", 
               RowBox[{"Int1", "[", 
                RowBox[{
                "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                 "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                 "\[Sigma]"}], "]"}]}], "-", "\[Beta]"}]}], "}"}]}], 
          "\[IndentingNewLine]", "}"}], "/.", 
         RowBox[{"Join", "[", 
