Cell[TextData[{
 "Let\[CloseCurlyQuote]s first generate all 10000 individuals, one set with \
positive correlation between ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "6bb30855-ae9a-a346-bdf4-87e62b5985f5"],
 " and NEC, another with negative correlation, and a last one with no \
correlation:"
}], "Text",
 CellChangeTimes->{{3.9714225711667824`*^9, 3.9714225880493393`*^9}, {
  3.9714226373573704`*^9, 3.9714226723958073`*^9}, {3.9714970019318295`*^9, 
  3.9714970122724323`*^9}, {3.9719333671490765`*^9, 
  3.9719333838736115`*^9}},ExpressionUUID->"5193aada-b775-e741-95af-\
46789bfed943"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "GenerateIndividuals", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"GenerateIndividuals", "[", "rhoAlphaNEC_", "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "Mu", ",", "sigmas", ",", "rhoMat", ",", "Sigma", ",", "dist", ",", 
      "samples"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Mu", "=", 
      RowBox[{"{", 
       RowBox[{"alpha", ",", "NEC"}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sigmas", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"alpha", "*", "CVi"}], ",", 
        RowBox[{"NEC", "*", "CVi"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"rhoMat", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "rhoAlphaNEC"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"rhoAlphaNEC", ",", "1"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Sigma", "=", 
      RowBox[{
       RowBox[{"DiagonalMatrix", "[", "sigmas", "]"}], ".", "rhoMat", ".", 
       RowBox[{"DiagonalMatrix", "[", "sigmas", "]"}]}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"dist", "=", 
      RowBox[{"MultinormalDistribution", "[", 
       RowBox[{"Mu", ",", "Sigma"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"samples", "=", 
      RowBox[{"RandomVariate", "[", 
       RowBox[{"dist", ",", "nID"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<alpha\>\"", "->", 
          RowBox[{"samples", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "1"}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<beta\>\"", "->", "beta"}], ",", 
         RowBox[{"(*", 
          RowBox[{"fixed", " ", "constant"}], "*)"}], "\[IndentingNewLine]", 
         RowBox[{"\"\<NEC\>\"", "->", 
          RowBox[{"samples", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "2"}], "]"}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"\"\<ID\>\"", "->", "i"}]}], "|>"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"i", ",", "nID"}], "}"}]}], "\[IndentingNewLine]", "]"}]}]}], 
   "\[IndentingNewLine]", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SeedRandom", "[", "42", "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhoAlphaNEC", "=", "0.9"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"individualsPos", "=", 
   RowBox[{"GenerateIndividuals", "[", "rhoAlphaNEC", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"individualsNeg", "=", 
   RowBox[{"GenerateIndividuals", "[", 
    RowBox[{"-", "rhoAlphaNEC"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"individualsNull", "=", 
   RowBox[{"GenerateIndividuals", "[", "0", "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.971415275043932*^9, 3.9714152967197704`*^9}, {
  3.9714160940512085`*^9, 3.9714161673891544`*^9}, {3.971416298736454*^9, 
  3.9714163338930073`*^9}, {3.971416456834749*^9, 3.9714164634303684`*^9}, {
  3.9714165558281384`*^9, 3.9714167586306705`*^9}, {3.9714168256747456`*^9, 
  3.971416844577036*^9}, {3.9714168863191643`*^9, 3.971416906327156*^9}, {
  3.9714169556846733`*^9, 3.9714169943345222`*^9}, {3.971417083124216*^9, 
  3.9714171559752254`*^9}, {3.971417209241562*^9, 3.971417215738554*^9}, {
  3.971420921915388*^9, 3.971420934739458*^9}, {3.9714211614757347`*^9, 
  3.9714211665667744`*^9}, {3.971422598814049*^9, 3.9714226126536503`*^9}, {
  3.971495645208523*^9, 3.9714956453408985`*^9}, {3.9714969741853237`*^9, 
  3.971496990099285*^9}},
 CellLabel->"In[15]:=",ExpressionUUID->"724b074b-a79f-d34d-8b0b-8f12c1d78cb0"],

Cell["Here are the three populations distributions:", "Text",
 CellChangeTimes->{{3.9714226205734158`*^9, 3.9714226335492344`*^9}, {
  3.9714226771801224`*^9, 3.9714226828607197`*^9}, {3.9714970232057323`*^9, 
