      RowBox[{"0.78", ",", "0.18", ",", "0.16"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "the", " ", "legend", " ", "separately"}], "*)"}], 
