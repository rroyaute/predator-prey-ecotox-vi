   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{
      RowBox[{"dataDir", "<>", "\"\<fig_3_data.csv\>\""}], ",", 
      "dataWithHeader"}], "]"}], ";"}]}]}]], "Input",
