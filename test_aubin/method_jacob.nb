       RowBox[{"blue", " ", "tone"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"RGBColor", "[", 
         RowBox[{"0.78", ",", "0.18", ",", "0.16"}], "]"}], ",", 
        RowBox[{"PointSize", "[", "0.002", "]"}]}], "]"}]}], "   ", 
     RowBox[{"(*", 
      RowBox[{"red", " ", "tone"}], "*)"}], "\[IndentingNewLine]", "}"}]}], ",",
    "\[IndentingNewLine]", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<alpha\>\"", ",", "\"\<NEC\>\""}], "}"}]}], ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"AspectRatio", "->", "1"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Positive cov\>\"", ",", "\"\<Negative cov\>\""}], "}"}]}]}],
   "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"SmoothHistogram", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"individualsPos", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<alpha\>\""}], "]"}], "]"}], ",", 
     RowBox[{"individualsPos", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<NEC\>\""}], "]"}], "]"}], ",", 
     RowBox[{"individualsNeg", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<alpha\>\""}], "]"}], "]"}], ",", 
     RowBox[{"individualsNeg", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "\"\<NEC\>\""}], "]"}], "]"}]}], "}"}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<alpha pos\>\"", ",", "\"\<NEC pos\>\"", 
      ",", "\"\<alpha neg\>\"", ",", "\"\<NEC neg\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{"PlotRange", "->", "All"}], ",", "\[IndentingNewLine]", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Value\>\"", ",", "\"\<Density\>\""}], "}"}]}], ",", 
   "\[IndentingNewLine]", 
