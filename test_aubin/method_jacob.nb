Cell[TextData[{
 "We can now compute the population distribution for each dose, and plot the \
mean ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Alpha]", 
        StyleBox["max", FontSlant -> "Plain"]], TraditionalForm], 
     "errors" -> {}, "input" -> "\\alpha_{\\mathrm{max}}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e320ffc2-8245-ea45-9cc4-93ef89ed0e32"],
 " and standard deviation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "2dee810d-c913-df46-9c85-d524c217ceb8"],
 " of the attack rate ",
 Cell[BoxData[
  FormBox["\[Alpha]", TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1df92f9b-53e8-7546-9d47-26f4577183ac"],
 " for varying concentrations.\n\nQUESTION : by doing this, it\
\[CloseCurlyQuote]s ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "max"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "c26c71e7-ca2a-514a-9b62-cc81e024fdc9"],
 " and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       SubscriptBox["\[Theta]", "\[Alpha]"], TraditionalForm], "errors" -> {},
      "input" -> "\\theta_{\\alpha}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "6a04ee52-6288-ad40-a81f-3300905cb65a"],
 " that change? Not ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Sigma]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eab4e239-e96a-8e48-bcb8-c86adc9d0ae9"],
 "?"
}], "Text",
 CellChangeTimes->{{3.9714227072261677`*^9, 3.971422796802988*^9}, {
  3.9714236924334126`*^9, 3.9714237081097584`*^9}, {3.9714237448478374`*^9, 
  3.9714237574200325`*^9}, {3.971424132715767*^9, 
  3.971424207265234*^9}},ExpressionUUID->"962480b8-2b89-5948-aadd-\
8e8480b90518"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SimulateDoseResponse", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SimulateDoseResponse", "[", "individuals_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"records", ",", "data"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"records", "=", 
       RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"a", "=", 
                RowBox[{"ind", "[", "\"\<alpha\>\"", "]"}]}], ",", 
               RowBox[{"b", "=", 
                RowBox[{"ind", "[", "\"\<beta\>\"", "]"}]}], ",", 
               RowBox[{"n", "=", 
                RowBox[{"ind", "[", "\"\<NEC\>\"", "]"}]}]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Table", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"logyhat", ",", "yhat", ",", "y"}], "}"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"logyhat", "=", 
                   RowBox[{"DRFunLog", "[", 
                    RowBox[{"d", ",", "a", ",", "b", ",", "n"}], "]"}]}], ";",
                   "\[IndentingNewLine]", 
                  RowBox[{"yhat", "=", 
                   RowBox[{"Exp", "[", "logyhat", "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"y", "=", 
                   RowBox[{"RandomVariate", "[", 
                    RowBox[{"LogNormalDistribution", "[", 
                    RowBox[{"logyhat", ",", "sigma"}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<ID\>\"", "->", 
                    RowBox[{"ind", "[", "\"\<ID\>\"", "]"}]}], ",", 
                    RowBox[{"\"\<Dose\>\"", "->", "d"}], ",", 
                    RowBox[{"\"\<logyhat\>\"", "->", "logyhat"}], ",", 
                    RowBox[{"\"\<yhat\>\"", "->", "yhat"}], ",", 
                    RowBox[{"\"\<y\>\"", "->", "y"}]}], "|>"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", "Dose"}], "}"}]}], "\[IndentingNewLine]", 
              "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"ind", ",", "individuals"}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", ",", "1"}], "\[IndentingNewLine]", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"records", ",", 
         RowBox[{"#Dose", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Compute", " ", "mean", " ", "and", " ", "sd", " ", "per", " ", 
        "Dose"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vals", "=", 
            RowBox[{"data", "[", "d", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Dose\>\"", "->", "d"}], ",", 
            RowBox[{"\"\<yhatMean\>\"", "->", 
             RowBox[{"Mean", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<yhat\>\""}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<yhatSD\>\"", "->", 
             RowBox[{"StandardDeviation", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<yhat\>\""}], "]"}], "]"}], "]"}]}]}],
            "|>"}]}], "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", 
          RowBox[{"Keys", "[", "data", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9714153107195663`*^9, 3.97141535237385*^9}, {
   3.9714153900077095`*^9, 3.971415469126137*^9}, 3.971417419658783*^9, {
   3.9714213742907047`*^9, 3.971421376326208*^9}},
 CellLabel->
  "In[1305]:=",ExpressionUUID->"3ae874e0-8e85-ee46-9156-949ec7ea9746"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Positive", " ", "covariance", " ", "between", " ", "alpha", " ", "and", " ",
     "NEC"}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"summaryPos", "=", 
     RowBox[{"SimulateDoseResponse", "[", "individualsPos", "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Negative", " ", "covariance", " ", "between", " ", "alpha", " ", "and", " ",
      "NEC"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"summaryNeg", "=", 
     RowBox[{"SimulateDoseResponse", "[", "individualsNeg", "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.9714154824406204`*^9, 3.9714154982890167`*^9}, 
   3.971416137030199*^9, {3.9714172263444157`*^9, 3.971417228609768*^9}, {
