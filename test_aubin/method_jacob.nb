   RowBox[{
    RowBox[{"beta", "=", 
     RowBox[{"-", "3.5"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Dose", "=", 
     RowBox[{"Range", "[", 
      RowBox[{"0", ",", "100", ",", "1"}], "]"}]}], ";"}], "\n", 
   RowBox[{
