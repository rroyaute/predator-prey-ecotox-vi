      RowBox[{"FUNCTIONS", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"cAttack", "=", 
     RowBox[{"Compile", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
