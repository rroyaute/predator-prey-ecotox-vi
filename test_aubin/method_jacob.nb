       RowBox[{"\[Nu]", "->", "1"}], ",", 
       RowBox[{"k", "->", "1"}], ",", 
       RowBox[{"\[Beta]", "->", "0.1"}], ",", 
       RowBox[{"X", "->", "X"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "EQUILIBRIUM"}]}], " ", 
      RowBox[{"SOLVER", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", "EqSol", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"EqSol", "[", 
      RowBox[{
       RowBox[{"dval_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]val_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"paramsSpec", ",", "Rsol", ",", "csol"}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"paramsSpec", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"paramsGen", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "->", 
              RowBox[{"X", "-", "dval"}]}], ",", 
             RowBox[{"h", "->", 
              RowBox[{"X", "-", "dval"}]}], ",", 
             RowBox[{"\[Sigma]", "->", "\[Sigma]val"}]}], "}"}]}], "]"}]}], ";",
         "\[IndentingNewLine]", 
        RowBox[{"Rsol", "=", 
         RowBox[{"Quiet", "@", 
          RowBox[{"FindRoot", "[", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"FNum", "[", 
                RowBox[{
                "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                 "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                 "\[Sigma]", ",", "\[Beta]", ",", "\[CurlyEpsilon]"}], "]"}], 
               "/.", " ", "paramsSpec"}], ")"}], "==", "0"}], ",", 
            RowBox[{"{", 
             RowBox[{"R", ",", "0.5"}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"Method", "->", "\"\<Secant\>\""}], ",", 
            RowBox[{"WorkingPrecision", "->", "20"}], ",", 
            RowBox[{"AccuracyGoal", "->", "8"}], ",", 
            RowBox[{"PrecisionGoal", "->", "8"}], ",", 
            RowBox[{"MaxIterations", "->", "100"}]}], "\[IndentingNewLine]", 
           "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"csol", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"c", "->", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"r", " ", "R", " ", 
                  RowBox[{"(", 
                   RowBox[{"1", "-", 
                    RowBox[{"R", "/", "k"}]}], ")"}]}], ")"}], "/", 
                RowBox[{"(", 
                 RowBox[{"R", " ", 
                  RowBox[{"Int1", "[", 
                   RowBox[{
                   "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",",
                     "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",",
                     "\[Sigma]"}], "]"}]}], ")"}]}], ")"}], "/.", " ", 
              "paramsSpec"}], ")"}]}], "/.", " ", "Rsol"}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"R", ",", "c"}], "}"}], "/.", " ", 
         RowBox[{"Join", "[", 
          RowBox[{"Rsol", ",", "csol"}], "]"}]}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"--", 
        RowBox[{"-", "DETERMINANT"}]}], "/", "TRACE"}], " ", 
      RowBox[{"COMPUTATION", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "DetTr", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"DetTr", "[", 
      RowBox[{
       RowBox[{"dval_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]val_", "?", "NumericQ"}], ",", 
       RowBox[{"{", 
        RowBox[{"Rval_", ",", "cval_"}], "}"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"paramsSpec", ",", "J"}], "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"paramsSpec", "=", 
         RowBox[{"Join", "[", 
          RowBox[{"paramsGen", ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "->", 
              RowBox[{"X", "-", "dval"}]}], ",", 
             RowBox[{"h", "->", 
              RowBox[{"X", "-", "dval"}]}], ",", 
             RowBox[{"\[Sigma]", "->", "\[Sigma]val"}], ",", 
             RowBox[{"R", "->", "Rval"}], ",", 
             RowBox[{"c", "->", "cval"}]}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"J", "=", 
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{
               RowBox[{"r", " ", 
                RowBox[{"(", 
                 RowBox[{"1", "-", 
                  RowBox[{"2", " ", 
                   RowBox[{"R", "/", "k"}]}]}], ")"}]}], "-", 
               RowBox[{"c", " ", 
                RowBox[{"Int2", "[", 
                 RowBox[{
                 "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",",
                   "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",",
                   "\[Sigma]"}], "]"}]}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"-", "R"}], " ", 
               RowBox[{"Int1", "[", 
                RowBox[{
                "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                 "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                 "\[Sigma]"}], "]"}]}]}], "}"}], ",", "\[IndentingNewLine]", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"\[CurlyEpsilon]", " ", "c", " ", 
               RowBox[{"Int2", "[", 
                RowBox[{
                "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
                 "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
                 "\[Sigma]"}], "]"}]}], ",", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"\[CurlyEpsilon]", " ", "R", " ", 
                RowBox[{"Int1", "[", 
                 RowBox[{
                 "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",",
                   "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",",
                   "\[Sigma]"}], "]"}]}], "-", "\[Beta]"}]}], "}"}]}], 
           "\[IndentingNewLine]", "}"}], "/.", " ", "paramsSpec"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Det", "[", "J", "]"}], ",", 
          RowBox[{"Tr", "[", "J", "]"}]}], "}"}]}]}], "\[IndentingNewLine]", 
      "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "CLASSIFICATION"}]}], " ", 
      RowBox[{"FUNCTION", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ClearAll", "[", "Classifying", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"Classifying", "[", 
      RowBox[{
       RowBox[{"dval_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]val_", "?", "NumericQ"}]}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"sol", ",", "coeffs"}], "}"}], ",", "\[IndentingNewLine]", 
