          RowBox[{"colNeg", ",", "Dashed", ",", "Thick"}], "]"}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"Directive", "[", 
          RowBox[{"colNeg", ",", "Thick"}], "]"}]}], "\[IndentingNewLine]", 
        "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"{", "\[IndentingNewLine]", 
        RowBox[{"\"\<Positive cov (mean)\>\"", ",", 
