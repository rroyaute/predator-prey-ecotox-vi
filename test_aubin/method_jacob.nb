Cell["\<\
Let\[CloseCurlyQuote]s move on to adding a pesticide concentration, and \
computing the response of the predator-prey system.\
\>", "Text",
 CellChangeTimes->{{3.971414545137001*^9, 
  3.9714145653152103`*^9}},ExpressionUUID->"3761bd9c-3630-d741-b904-\
e0b48d5652ac"],

Cell[CellGroupData[{

Cell["Dose-response functions", "Section",
 CellChangeTimes->{{3.971414534835203*^9, 
  3.971414538599411*^9}},ExpressionUUID->"6dd3eae3-5b00-f04b-a9b4-\
59cf9db8dae5"],

Cell[TextData[{
 "Here are the defined the (individual) dose-response functions of a compound \
on a given parameter:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         StyleBox["y", "TI"], 
         RowBox[{"(", 
           StyleBox["C", "TI"], ")"}], "\[LongEqual]", 
         RowBox[{"{", 
           Cell[
            BoxData[
             FormBox[
              GridBox[{{
                 Cell[
                  TextData[{
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["y", "TI"], "0"], " if ", 
                    StyleBox["C", "TI"], "\[LessEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}]], "InlineFormula"]}]]}, {
                 Cell[
                  TextData[{
                    Cell[
                    BoxData[
                    RowBox[{
                    SubscriptBox[
                    StyleBox["y", "TI"], "0"], 
                    SuperscriptBox[
                    StyleBox["e", "TI"], 
                    RowBox[{"-", "\[Beta]", 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["C", "TI"], "-", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}], ")"}]}]], " if ", 
                    StyleBox["C", "TI"], "\[GreaterEqual]", 
                    SubscriptBox[
                    StyleBox["C", "TI"], "0"]}]], "InlineFormula"]}]]}}, 
               ColumnAlignments -> Left], TraditionalForm]]]}]}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "y(C)=\\left\\{\\begin{array}{l}y_0\\text{ if }C\\leq C_0\\\\y_0 \
e^{-\\beta (C-C_0)}\\text{ if }C\\geq C_0\\end{array}\\right.", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "425cabc8-3491-ce45-b7fd-8a82e5adf99e"],
 "\nThe idea here is to investigate the impact of a pesticide on a \
predator-prey ecosystem."
}], "Text",
 CellChangeTimes->{{3.971421552044859*^9, 3.9714216378612194`*^9}, {
  3.9714218192187996`*^9, 
  3.9714219044166183`*^9}},ExpressionUUID->"5beaf01a-af62-b141-8b4f-\
74d329be93e8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", 
    RowBox[{"DRLogRNFun", ",", "DRFunLog", ",", "DRFunLogExp"}], "]"}], ";"}],
   "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_logRN", "_fun"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DRLogRNFun", "[", 
    RowBox[{"Dose_", ",", "Rmin_", ",", "Rmax_", ",", "beta_", ",", "NEC_"}], 
    "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"logyhat", ",", "yhat"}], "}"}], ",", 
     RowBox[{
      RowBox[{"logyhat", "=", 
       RowBox[{"Rmin", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Rmax", "-", "Rmin"}], ")"}], "*", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"Exp", "[", "beta", "]"}]}], "*", 
           RowBox[{"(", 
            RowBox[{"Dose", "-", "NEC"}], ")"}], "*", 
           RowBox[{"Boole", "[", 
            RowBox[{"Dose", ">", "NEC"}], "]"}]}], "]"}]}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"yhat", "=", 
       RowBox[{"Exp", "[", "logyhat", "]"}]}], ";", "\[IndentingNewLine]", 
      "yhat"}]}], "]"}]}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_fun", "_log"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DRFunLog", "[", 
    RowBox[{"Dose_", ",", "alpha_", ",", "beta_", ",", "NEC_"}], "]"}], ":=", 
   RowBox[{"Piecewise", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Log", "[", "alpha", "]"}], ",", 
        RowBox[{"Dose", "<", "NEC"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Log", "[", "alpha", "]"}], "-", 
         RowBox[{
          RowBox[{"Exp", "[", "beta", "]"}], "*", 
          RowBox[{"(", 
           RowBox[{"Dose", "-", "NEC"}], ")"}]}]}], ",", 
        RowBox[{"Dose", ">=", "NEC"}]}], "}"}]}], "}"}], "]"}]}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Equivalent", " ", "to", " ", "DR_fun", "_log", "_exp"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"DRFunLogExp", "[", 
   RowBox[{"Dose_", ",", "alpha_", ",", "beta_", ",", "NEC_"}], "]"}], ":=", 
  RowBox[{"Exp", "[", 
   RowBox[{"DRFunLog", "[", 
    RowBox[{"Dose", ",", "alpha", ",", "beta", ",", "NEC"}], "]"}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.971414576729849*^9, 3.971414576729849*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"43394746-549f-ff43-b28f-63752ed2e5b8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Dose-response simulations", "Section",
 CellChangeTimes->{{3.9714145969645824`*^9, 
  3.9714146007886505`*^9}},ExpressionUUID->"95a8c983-6913-c544-a723-\
ac5a3f645270"],

Cell[TextData[{
 "We will firstly generate a population of 10000 individuals, each with a \
phenotypic trait ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "196fef1e-3b05-2449-a2a3-2601131c6671"],
 " following a normal distribution around ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "7b1547af-7073-3840-8743-a59b5b581e3c"],
 ", with standard deviation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],ExpressionUUID->
  "22012a52-ec71-664d-92f2-2740b6f947c6"],
 ".\nEach individual also has a different minimal pesticide concentration \
(NEC) above which the trait ",
 Cell[BoxData[
  FormBox["x", TraditionalForm]],ExpressionUUID->
  "b6cd145f-b397-f046-9f72-15a56ccfa747"],
 " decays to zero.\nFor a single individual, the dose-response function is:\n",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"{", 
         Cell[
          BoxData[
           FormBox[
            GridBox[{{
               Cell[
                TextData[{
                  Cell[
                   BoxData[
                    RowBox[{"\[Alpha]", " if ", 
                    StyleBox["C", "TI"], "\[LessEqual]", 
                    StyleBox["NEC", FontSlant -> "Plain"]}]], 
                   "InlineFormula"]}]]}, {
               Cell[
                TextData[{
                  Cell[
                   BoxData[
                    RowBox[{"\[Alpha]", 
                    SuperscriptBox[
                    StyleBox["e", "TI"], 
                    RowBox[{"-", 
                    SuperscriptBox[
                    StyleBox["e", "TI"], "\[Beta]"], 
                    RowBox[{"(", 
                    RowBox[{
                    StyleBox["C", "TI"], "-", 
                    StyleBox["NEC", FontSlant -> "Plain"]}], ")"}]}]], " if ", 
                    StyleBox["C", "TI"], "\[GreaterEqual]", 
                    StyleBox["NEC", FontSlant -> "Plain"]}]], 
                   "InlineFormula"]}]]}}, ColumnAlignments -> Left], 
            TraditionalForm]]]}], TraditionalForm], "errors" -> {}, "input" -> 
     "\\left\\{\\begin{array}{l}\n\\alpha\\text{ if }C\\leq\\mathrm{NEC}\\\\\n\
\\alpha e^{-e^{\\beta}(C-\\mathrm{NEC})}\\text{ if }C\\geq\\mathrm{NEC}\n\
\\end{array}\\right.", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "44a0d86e-0af9-f344-9fbf-0d43e363188e"],
 "\nHere, we\[CloseCurlyQuote]ll take ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["x", "TI"], "_"], "\[LongEqual]", "100"}], 
       TraditionalForm], "errors" -> {}, "input" -> "\\bar{x}=100", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "99f7127b-25b1-4e47-8251-22647fa2f1ce"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"\[Sigma]", "\[LongEqual]", "0.2", "\[Cross]", 
         OverscriptBox[
          StyleBox["x", "TI"], "_"], "\[LongEqual]", "20"}], TraditionalForm],
      "errors" -> {}, "input" -> "\\sigma=0.2\\times\\bar{x}=20", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "ad3b9ccc-f074-2c4f-b721-c4c46c61d5ad"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         OverscriptBox[
          StyleBox["NEC", FontSlant -> "Plain"], "_"], "\[LongEqual]", "25"}],
        TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{\\mathrm{NEC}}=25", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "eb3a5682-72b0-594d-acda-1cedf96413b3"],
 ", ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Sigma]", 
          StyleBox["NEC", FontSlant -> "Plain"]], "\[LongEqual]", "0.2", 
         "\[Cross]", 
         OverscriptBox[
          StyleBox["NEC", FontSlant -> "Plain"], "_"], "\[LongEqual]", "5"}], 
       TraditionalForm], "errors" -> {}, "input" -> 
     "\\sigma_{\\mathrm{NEC}}=0.2\\times\\bar{\\mathrm{NEC}}=5", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "f8fbadb7-4403-264e-a60f-3dc4f26bb5c9"],
 ", and ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         SubscriptBox["\[Rho]", 
          RowBox[{
            StyleBox["x", "TI"], ",", 
            StyleBox["NEC", FontSlant -> "Plain"]}]], "\[LongEqual]", "0", 
         " or ", "\[PlusMinus]", "0.9"}], TraditionalForm], "errors" -> {}, 
     "input" -> "\\rho_{x,\\mathrm{NEC}}=0\\text{ or }\\pm0.9", "state" -> 
     "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "664215d5-85b9-8f4f-a6e0-c377fd104109"],
 ", with ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{
         RowBox[{"(", 
           RowBox[{
             StyleBox["x", "TI"], ",", 
             StyleBox["NEC", FontSlant -> "Plain"]}], ")"}], "\[Tilde]", 
         StyleBox["M", "TI"], 
         StyleBox["V", "TI"], 
         StyleBox["N", "TI"], 
         RowBox[{"(", "\[CapitalSigma]", ")"}]}], TraditionalForm], 
     "errors" -> {}, "input" -> 
     "(x,\\mathrm{NEC}})\\sim MV \\mathcal{N}(\\Sigma)", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "97e2cc40-225c-fd4a-85e5-8a7191505f4f"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[CapitalSigma]", "=", 
    RowBox[{
     RowBox[{"(", GridBox[{
        {"\[Sigma]", "0"},
        {"0", 
         SubscriptBox["\[Sigma]", "NEC"]}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {"1", 
         SubscriptBox["\[Rho]", 
          RowBox[{"x", ",", "NEC"}]]},
        {
         SubscriptBox["\[Rho]", 
          RowBox[{"x", ",", "NEC"}]], "1"}
       }], ")"}], 
     RowBox[{"(", GridBox[{
        {"\[Sigma]", "0"},
        {"0", 
         SubscriptBox["\[Sigma]", "NEC"]}
       }], ")"}]}]}], TraditionalForm]],ExpressionUUID->
  "7762f389-565b-184c-bd90-c0febe6d1f4a"],
 "."
}], "Text",
 CellChangeTimes->{{3.9714219178079414`*^9, 3.971421994826397*^9}, {
   3.971422213642174*^9, 3.9714222377634163`*^9}, {3.9714224302834206`*^9, 
   3.97142246337624*^9}, 3.9714972373320484`*^9, {3.971931691652937*^9, 
   3.971931804942564*^9}, {3.9719323693630867`*^9, 3.971932425285755*^9}, {
   3.9719327259681396`*^9, 3.9719327284865074`*^9}, {3.9719327694433365`*^9, 
   3.9719328516714783`*^9}, {3.971932882040638*^9, 3.971932898670864*^9}, {
   3.971932968135685*^9, 3.971932973764715*^9}, {3.971933005384205*^9, 
   3.9719330067029667`*^9}, {3.9719330372847137`*^9, 
   3.9719330443233852`*^9}, {3.971933075355324*^9, 3.9719330754430447`*^9}, {
   3.9719332072835217`*^9, 
   3.9719333029749947`*^9}},ExpressionUUID->"22016717-3f2c-1a47-9b3a-\
dfe1d3885feb"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", " ", "GLOBAL"}]}], " ", 
     RowBox[{"PARAMETERS", " ", "--"}]}], "-"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
