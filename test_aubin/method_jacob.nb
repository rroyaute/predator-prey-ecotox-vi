 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"-", "0.006762211008752211`"}], ",", 
     RowBox[{"-", "0.20000000000000007`"}]}], "}"}], ",", 
