  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"raw", "=", 
   RowBox[{"Import", "[", 
    RowBox[{"dataDir", "<>", "\"\<fig_3_data_opti.csv\>\""}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dvals", "=", 
   RowBox[{"ToExpression", "/@", 
    RowBox[{"Rest", "[", 
