       RowBox[{"h_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]min_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Eta]max_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Nu]_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
       RowBox[{"X_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Sigma]_", "?", "NumericQ"}]}], "]"}], ":=", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Int1", "[", 
       RowBox[{
       "R", ",", "a", ",", "\[Alpha]", ",", "\[Tau]", ",", "h", ",", 
        "\[Eta]min", ",", "\[Eta]max", ",", "\[Nu]", ",", "X", ",", 
        "\[Sigma]"}], "]"}], "=", 
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"xmin", "=", 
