Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Mean", " ", "and", " ", "SD", " ", "table", " ", "for", " ", "each", " ", 
    "Dose"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"meanPos", "=", 
     RowBox[{
      RowBox[{"summaryPos", "[", 
       RowBox[{"[", "All", "]"}], "]"}], "/.", 
      RowBox[{"assoc_Association", ":>", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
         RowBox[{"assoc", "[", "\"\<yhatMean\>\"", "]"}]}], "}"}]}]}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"meanNeg", "=", 
     RowBox[{
      RowBox[{"summaryNeg", "[", 
       RowBox[{"[", "All", "]"}], "]"}], "/.", 
      RowBox[{"assoc_Association", ":>", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
         RowBox[{"assoc", "[", "\"\<yhatMean\>\"", "]"}]}], "}"}]}]}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stdPos", "=", 
     RowBox[{
      RowBox[{"summaryPos", "[", 
       RowBox[{"[", "All", "]"}], "]"}], "/.", 
      RowBox[{"assoc_Association", ":>", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
         RowBox[{"assoc", "[", "\"\<yhatSD\>\"", "]"}]}], "}"}]}]}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"stdNeg", "=", 
     RowBox[{
      RowBox[{"summaryNeg", "[", 
       RowBox[{"[", "All", "]"}], "]"}], "/.", 
      RowBox[{"assoc_Association", ":>", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"assoc", "[", "\"\<Dose\>\"", "]"}], ",", 
         RowBox[{"assoc", "[", "\"\<yhatSD\>\"", "]"}]}], "}"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Find", " ", "y"}], "-", 
     RowBox[{"range", " ", "for", " ", "scaling"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ymin1", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ymax1", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"meanPos", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ymin2", "=", "0"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"ymax2", "=", 
     RowBox[{"Max", "[", 
      RowBox[{"stdPos", "[", 
       RowBox[{"[", 
        RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Function", " ", "to", " ", "rescale", " ", "SD", " ", "to", " ", "mean", 
     " ", "range", " ", "for", " ", "plotting"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"rescale", "[", "y_", "]"}], ":=", 
     RowBox[{"Rescale", "[", 
      RowBox[{"y", ",", 
       RowBox[{"{", 
        RowBox[{"ymin2", ",", "ymax2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ymin1", ",", "ymax1"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Create", " ", "scaled", " ", "SD", " ", "data"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"stdPosScaled", "=", 
     RowBox[{"stdPos", "/.", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x_", ",", "y_"}], "}"}], ":>", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"rescale", "[", "y", "]"}]}], "}"}]}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stdNegScaled", "=", 
     RowBox[{"stdNeg", "/.", " ", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"x_", ",", "y_"}], "}"}], ":>", 
       RowBox[{"{", 
        RowBox[{"x", ",", 
         RowBox[{"rescale", "[", "y", "]"}]}], "}"}]}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Helper", " ", "for", " ", "round"}], "-", 
     RowBox[{"number", " ", "ticks"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"niceTicks", "[", 
      RowBox[{"min_", ",", "max_", ",", "step_"}], "]"}], ":=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"Round", "[", "t", "]"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"t", ",", 
         RowBox[{
          RowBox[{"Ceiling", "[", 
           RowBox[{"min", "/", "step"}], "]"}], "*", "step"}], ",", 
         RowBox[{
          RowBox[{"Floor", "[", 
           RowBox[{"max", "/", "step"}], "]"}], "*", "step"}], ",", "step"}], 
        "}"}]}], "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{"(*", 
    RowBox[{"Step", " ", "sizes"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stepMean", "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ymax1", "-", "ymin1"}], ")"}], "/", "5"}], ",", "5"}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"stepSD", "=", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"ymax2", "-", "ymin2"}], ")"}], "/", "5"}], ",", "5"}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Left", " ", "ticks", " ", 
     RowBox[{"(", "mean", ")"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"leftTicks", "=", 
     RowBox[{"niceTicks", "[", 
      RowBox[{"ymin1", ",", "ymax1", ",", "stepMean"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Right", " ", "ticks", " ", 
      RowBox[{"(", "SD", ")"}]}], "\[LongDash]", 
     RowBox[{"force", " ", "numeric", " ", "positions"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"valsSD", "=", 
     RowBox[{"Range", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
        RowBox[{"Ceiling", "[", 
         RowBox[{"ymin2", "/", "stepSD"}], "]"}], "*", "stepSD"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"Floor", "[", 
         RowBox[{"ymax2", "/", "stepSD"}], "]"}], "*", "stepSD"}], ",", 
       "\[IndentingNewLine]", "stepSD"}], "\[IndentingNewLine]", "]"}]}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"rightTicks", "=", 
     RowBox[{"Table", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"N", "[", 
          RowBox[{"rescale", "[", "v", "]"}], "]"}], ",", 
         RowBox[{"ToString", "[", 
          RowBox[{"Round", "[", "v", "]"}], "]"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"{", 
        RowBox[{"v", ",", "valsSD"}], "}"}]}], "\[IndentingNewLine]", "]"}]}],
     ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", "Colors", "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"colPos", "=", 
     RowBox[{"RGBColor", "[", 
      RowBox[{"0.01", ",", "0.39", ",", "0.57"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"colNeg", "=", 
