Cell[BoxData[{
 RowBox[{
  RowBox[{"dataPos", "=", 
   RowBox[{
    RowBox[{"individualsPos", "[", 
     RowBox[{"[", 
      RowBox[{"All", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<alpha\>\"", ",", "\"\<NEC\>\""}], "}"}]}], "]"}], "]"}], 
    "/.", 
