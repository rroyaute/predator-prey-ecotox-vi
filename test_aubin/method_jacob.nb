Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "GLOBAL"}]}], " ", 
     RowBox[{"SETTINGS", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", "\"\<Global`*\>\"", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"SetOptions", "[", 
     RowBox[{"NIntegrate", ",", 
      RowBox[{"Method", "->", "\"\<LocalAdaptive\>\""}], ",", 
      RowBox[{"MaxRecursion", "->", "20"}], ",", 
      RowBox[{"AccuracyGoal", "->", "6"}], ",", 
      RowBox[{"PrecisionGoal", "->", "6"}]}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"X", "=", "3"}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"arbitrary", ",", " ", 
     RowBox[{"can", " ", "be", " ", "any", " ", "real", " ", "number"}]}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "COMPILED"}]}], " ", "HELPER", " ", 
      RowBox[{"FUNCTIONS", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cAttack", "=", 
     RowBox[{"Compile", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"a", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Alpha]", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Tau]", ",", "_Real"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Alpha]", " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "a"}], ")"}], "^", "2"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"\[Tau]", "^", "2"}]}], ")"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cHandling", "=", 
     RowBox[{"Compile", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"h", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]min", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]max", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Nu]", ",", "_Real"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{"\[Eta]max", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Eta]max", "-", "\[Eta]min"}], ")"}], " ", 
         RowBox[{"Exp", "[", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "-", "h"}], ")"}], "^", "2"}]}], "/", 
           RowBox[{"(", 
            RowBox[{"2", " ", 
             RowBox[{"\[Nu]", "^", "2"}]}], ")"}]}], "]"}]}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"cPdist", "=", 
     RowBox[{"Compile", "[", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"x", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"X", ",", "_Real"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Sigma]", ",", "_Real"}], "}"}]}], "}"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"1", "/", 
         RowBox[{"Sqrt", "[", 
          RowBox[{"2", " ", "\[Pi]", " ", "\[Sigma]"}], "]"}]}], " ", 
        RowBox[{"Exp", "[", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "X"}], ")"}], "^", "2"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", "\[Sigma]"}], ")"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "MEMOIZED"}]}], " ", 
      RowBox[{"INTEGRALS", "--"}]}], "-"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"Int1", ",", "Int2"}], "]"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Int1", "[", 
      RowBox[{
       RowBox[{"R_", "?", "NumericQ"}], ",", "\[IndentingNewLine]", 
       RowBox[{"a_", "?", "NumericQ"}], ",", 
       RowBox[{"\[Alpha]_", "?", "NumericQ"}], ",", 
