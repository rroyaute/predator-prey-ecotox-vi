Cell[TextData[{
 "We can now compute the population distribution for each dose, and plot mean \
",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       OverscriptBox[
        StyleBox["x", "TI"], "_"], TraditionalForm], "errors" -> {}, "input" -> 
     "\\bar{x}", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "0932d7ac-ffb5-1743-8d37-7071b0dcf046"],
 " and standard deviation ",
 Cell[BoxData[
  FormBox["\[Sigma]", TraditionalForm]],ExpressionUUID->
  "2dee810d-c913-df46-9c85-d524c217ceb8"],
 " for varying concentrations."
}], "Text",
 CellChangeTimes->{{3.9714227072261677`*^9, 3.971422796802988*^9}, {
  3.9714236924334126`*^9, 3.9714237081097584`*^9}, {3.9714237448478374`*^9, 
  3.9714237574200325`*^9}, {3.971424132715767*^9, 3.971424207265234*^9}, {
  3.9719334219012566`*^9, 
  3.971933451413784*^9}},ExpressionUUID->"962480b8-2b89-5948-aadd-\
8e8480b90518"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "SimulateDoseResponse", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"SimulateDoseResponse", "[", "individuals_List", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"records", ",", "data"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"records", "=", 
       RowBox[{"Flatten", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"Table", "[", "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"a", "=", 
                RowBox[{"ind", "[", "\"\<alpha\>\"", "]"}]}], ",", 
               RowBox[{"b", "=", 
                RowBox[{"ind", "[", "\"\<beta\>\"", "]"}]}], ",", 
               RowBox[{"n", "=", 
                RowBox[{"ind", "[", "\"\<NEC\>\"", "]"}]}]}], "}"}], ",", 
             "\[IndentingNewLine]", 
             RowBox[{"Table", "[", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"Module", "[", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{"logyhat", ",", "yhat", ",", "y"}], "}"}], ",", 
                 "\[IndentingNewLine]", 
                 RowBox[{
                  RowBox[{"logyhat", "=", 
                   RowBox[{"DRFunLog", "[", 
                    RowBox[{"d", ",", "a", ",", "b", ",", "n"}], "]"}]}], ";",
                   "\[IndentingNewLine]", 
                  RowBox[{"yhat", "=", 
                   RowBox[{"Exp", "[", "logyhat", "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"y", "=", 
                   RowBox[{"RandomVariate", "[", 
                    RowBox[{"LogNormalDistribution", "[", 
                    RowBox[{"logyhat", ",", "sigma"}], "]"}], "]"}]}], ";", 
                  "\[IndentingNewLine]", 
                  RowBox[{"<|", 
                   RowBox[{
                    RowBox[{"\"\<ID\>\"", "->", 
                    RowBox[{"ind", "[", "\"\<ID\>\"", "]"}]}], ",", 
                    RowBox[{"\"\<Dose\>\"", "->", "d"}], ",", 
                    RowBox[{"\"\<logyhat\>\"", "->", "logyhat"}], ",", 
                    RowBox[{"\"\<yhat\>\"", "->", "yhat"}], ",", 
                    RowBox[{"\"\<y\>\"", "->", "y"}]}], "|>"}]}]}], "]"}], ",", 
               RowBox[{"{", 
                RowBox[{"d", ",", "Dose"}], "}"}]}], "\[IndentingNewLine]", 
              "]"}]}], "\[IndentingNewLine]", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"ind", ",", "individuals"}], "}"}]}], "]"}], 
         "\[IndentingNewLine]", ",", "1"}], "\[IndentingNewLine]", "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"data", "=", 
       RowBox[{"GroupBy", "[", 
        RowBox[{"records", ",", 
         RowBox[{"#Dose", "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Compute", " ", "mean", " ", "and", " ", "sd", " ", "per", " ", 
        "Dose"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Table", "[", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"With", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"vals", "=", 
            RowBox[{"data", "[", "d", "]"}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"<|", 
           RowBox[{
            RowBox[{"\"\<Dose\>\"", "->", "d"}], ",", 
            RowBox[{"\"\<yhatMean\>\"", "->", 
             RowBox[{"Mean", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<yhat\>\""}], "]"}], "]"}], "]"}]}], ",", 
            RowBox[{"\"\<yhatSD\>\"", "->", 
             RowBox[{"StandardDeviation", "[", 
              RowBox[{"vals", "[", 
               RowBox[{"[", 
                RowBox[{"All", ",", "\"\<yhat\>\""}], "]"}], "]"}], "]"}]}]}],
            "|>"}]}], "\[IndentingNewLine]", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"d", ",", 
          RowBox[{"Keys", "[", "data", "]"}]}], "}"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9714153107195663`*^9, 3.97141535237385*^9}, {
   3.9714153900077095`*^9, 3.971415469126137*^9}, 3.971417419658783*^9, {
   3.9714213742907047`*^9, 3.971421376326208*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"3ae874e0-8e85-ee46-9156-949ec7ea9746"],

