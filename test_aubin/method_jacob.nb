           RowBox[{"{", 
            RowBox[{
             RowBox[{"R", "->", "Rsol"}], ",", 
             RowBox[{"c", "->", "csol"}]}], "}"}]}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
