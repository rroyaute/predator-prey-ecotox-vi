            RowBox[{"(", 
             RowBox[{"x", "-", "a"}], ")"}], "^", "2"}]}], "/", 
          RowBox[{"(", 
           RowBox[{"2", " ", 
            RowBox[{"\[Tau]", "^", "2"}]}], ")"}]}], "]"}]}]}], 
      "\[IndentingNewLine]", "]"}]}], ";"}], "\n", 
   RowBox[{
