         "\[IndentingNewLine]", "\"\<Negative cov (std)\>\""}], 
        "\[IndentingNewLine]", "}"}], ",", "\[IndentingNewLine]", 
       RowBox[{"LegendFunction", "->", "\"\<Frame\>\""}], ",", 
       "\[IndentingNewLine]", 
